COMPOSE_PROJECT_NAME=skillmind

# Existing shared Traefik contract. Skillmind does not deploy Traefik.
SKILLMIND_HOST=skillmind.example.com
SKILLMIND_CONTEXT_PATH=/skillmind
TRAEFIK_NETWORK=traefik-public
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_TLS=true

# Application
SKILLMIND_ENVIRONMENT=production
SKILLMIND_TIMEZONE=Asia/Tokyo
SKILLMIND_LOG_LEVEL=INFO
SKILLMIND_API_PORT=8000
SKILLMIND_CONTRACTS_DIR=/app/contracts
SKILLMIND_TRUSTED_PROXY_CIDRS=172.16.0.0/12
SKILLMIND_SSE_HEARTBEAT_SECONDS=15
SKILLMIND_AUTH_LOGIN_CSRF_TTL_SECONDS=300
SKILLMIND_AUTH_SESSION_IDLE_MINUTES=30
SKILLMIND_AUTH_SESSION_ABSOLUTE_HOURS=12
SKILLMIND_AUTH_ADMIN_SESSION_ABSOLUTE_HOURS=8
SKILLMIND_AUTH_LOGIN_ATTEMPTS_PER_MINUTE=5
# 来源 quota は login-context と login の両 request を数える。
SKILLMIND_AUTH_LOGIN_ACCOUNT_ATTEMPTS_PER_MINUTE=15
SKILLMIND_AUTH_LOGIN_SOURCE_REQUESTS_PER_MINUTE=100
SKILLMIND_AUTH_LOGIN_PROTECTION_TIMEOUT_SECONDS=2

# PostgreSQL
POSTGRES_DB=skillmind
POSTGRES_USER=skillmind
POSTGRES_PASSWORD=change-me
SKILLMIND_DATABASE_URL=postgresql+asyncpg://skillmind:change-me@postgres:5432/skillmind

# Redis / ARQ
SKILLMIND_REDIS_URL=redis://redis:6379/0
SKILLMIND_QUEUE_NAME=skillmind:runs
SKILLMIND_WORKER_DISPATCH_ENABLED=false
# 首版は false。外部 write・調度・子 Agent の拡張開発環境だけ明示的に true にする。
SKILLMIND_DEFERRED_FEATURES_ENABLED=false
# PostgreSQL の批准済み INSERT/UPDATE のみを有効化する。
SKILLMIND_DATABASE_WRITES_ENABLED=false
# Project 文書庫への批准済み Artifact CREATE のみ。API/Worker で同じ値を使う。
SKILLMIND_DOCUMENT_WRITES_ENABLED=false
SKILLMIND_OUTBOX_BATCH_SIZE=20
SKILLMIND_RUN_LEASE_SECONDS=60
SKILLMIND_RUN_MAX_ATTEMPTS=3
# 資源取得と ContextBuilder の準備期限。モデルの wall timeout と終態 transaction には適用しない。
SKILLMIND_RUN_PREPARATION_TIMEOUT_SECONDS=300
SKILLMIND_RUN_WORKSPACE_ROOT=/var/lib/skillmind/runs
# 各資源 root の物化上限。manifest・索引も含め、超過時は切り詰めず準備を拒否する。
SKILLMIND_WORKSPACE_MATERIALIZE_MAX_BYTES=10485760
SKILLMIND_WORKSPACE_MATERIALIZE_MAX_FILES=500
# Run 全入力の最終存量。逐 root の上限とは独立し、全 root 完成前には Agent を起動しない。
SKILLMIND_WORKSPACE_MATERIALIZE_TOTAL_MAX_BYTES=104857600
SKILLMIND_WORKSPACE_MATERIALIZE_TOTAL_MAX_FILES=5000
# Timeout for a single git/svn command issued by the repository Provider (seconds).
SKILLMIND_REPOSITORY_COMMAND_TIMEOUT_SECONDS=120
# 扇出子 Agent 一路あたりの打ち切り秒数。Run の wall timeout (900) より必ず短くする。
SKILLMIND_SUBAGENT_BRANCH_TIMEOUT_SECONDS=300

# Object storage. M0 accesses this only through the API/Worker boundary.
MINIO_ROOT_USER=skillmind
MINIO_ROOT_PASSWORD=change-me-too
SKILLMIND_OBJECT_STORAGE_ENDPOINT=http://object-storage:9000
SKILLMIND_OBJECT_STORAGE_BUCKET=skillmind
SKILLMIND_OBJECT_STORAGE_ACCESS_KEY=skillmind
SKILLMIND_OBJECT_STORAGE_SECRET_KEY=change-me-too
# 保存先世代ごとに生成し、API/Worker と復元清単で同じ UUID を保持する。
# 配備前に下行を有効化し非ゼロ UUID を指定する。未指定は migration-check/readiness で停止する。
# 更新時は既存値を保持する。自動生成・既存文書への backfill は行わない。
# SKILLMIND_OBJECT_STORAGE_NAMESPACE_ID=<new-storage-generation-uuid>
# Upload limits: per-file bytes, per-Project quota bytes, and the allowed content-type allowlist (JSON array).
SKILLMIND_DOCUMENT_MAX_BYTES=26214400
SKILLMIND_PROJECT_DOCUMENT_QUOTA_BYTES=524288000
SKILLMIND_DOCUMENT_ALLOWED_CONTENT_TYPES=["text/plain","text/markdown","text/csv","text/html","application/json","application/yaml","application/pdf","application/vnd.openxmlformats-officedocument.spreadsheetml.sheet","application/vnd.ms-excel","image/png","image/jpeg","image/gif","application/zip"]

# Managed secret envelope encryption (KEK) for MANAGED SecretReferences.
# Format: comma-separated "version:base64key" keyring; the first entry is the active key used for new
# encryption and the rest are decrypt-only during rotation. Each key MUST be 32 random bytes, base64
# encoded (generate with: python -c "import base64,os;print('v1:'+base64.b64encode(os.urandom(32)).decode())").
# Leave empty to disable MANAGED (ENVIRONMENT/FILE stay available). Store the KEK apart from DB backups.
SKILLMIND_MANAGED_SECRET_KEK=

# Model/provider credentials are consumed by the controlled Worker boundary.
# ANTHROPIC_MODEL is also the audited primary model ID for each Run and may name a custom model.
ANTHROPIC_BASE_URL=
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_MODEL=
ANTHROPIC_DEFAULT_OPUS_MODEL=
ANTHROPIC_DEFAULT_SONNET_MODEL=
ANTHROPIC_DEFAULT_HAIKU_MODEL=
CLAUDE_CODE_SUBAGENT_MODEL=
CLAUDE_CODE_EFFORT_LEVEL=

# Skill interpreter JSON handling. Leave false when the endpoint supports Anthropic structured
# outputs (output_format: json_schema). Set true for Anthropic-compatible endpoints that only offer
# json_object and return the JSON in the message text (e.g. Kimi): the interpreter then accepts a
# JSON object parsed from the prompt-guided text, with schema validation + repair still enforced.
SKILLMIND_SKILL_INTERPRETER_ACCEPT_PROMPT_JSON=false
