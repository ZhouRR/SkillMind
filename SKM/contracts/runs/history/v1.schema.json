{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.skillmind.local/runs/history/v1.schema.json",
  "title": "Skillmind project Run history v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["items", "limit", "offset", "has_more"],
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["run_id", "project_id", "task_id", "status", "row_version", "created_at", "started_at", "finished_at", "input", "selected_sources", "result_summary", "result_confidence", "result_needs_review"],
        "properties": {
          "run_id": { "type": "string", "format": "uuid" },
          "project_id": { "type": "string", "format": "uuid" },
          "task_id": { "type": "string", "format": "uuid" },
          "status": { "enum": ["QUEUED", "PREPARING", "RUNNING", "RETRY_PENDING", "WAITING_PERMISSION", "WAITING_FOR_INPUT", "WAITING_FOR_APPROVAL", "SUCCEEDED", "FAILED", "CANCELLED"] },
          "row_version": { "type": "integer", "minimum": 1 },
          "created_at": { "type": "string", "format": "date-time" },
          "started_at": { "type": ["string", "null"], "format": "date-time" },
          "finished_at": { "type": ["string", "null"], "format": "date-time" },
          "input": { "type": "object" },
          "selected_sources": {
            "type": "object",
            "additionalProperties": {
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "provider": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "capability": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "resource_kind": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "access": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  }
                }
              ]
            }
          },
          "result_summary": { "type": ["string", "null"] },
          "result_confidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
          "result_needs_review": { "type": ["boolean", "null"] }
        }
      }
    },
    "limit": { "type": "integer", "minimum": 1, "maximum": 100 },
    "offset": { "type": "integer", "minimum": 0 },
    "has_more": { "type": "boolean" }
  }
}
