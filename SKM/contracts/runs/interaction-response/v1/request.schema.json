{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.skillmind.local/runs/interaction-response/v1/request.schema.json",
  "title": "Skillmind InteractionResponse request v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["interaction_version", "response"],
  "properties": {
    "interaction_version": { "type": "integer", "minimum": 1 },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "text": { "type": "string", "minLength": 1, "maxLength": 10000 },
        "selected_option_keys": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]*$", "maxLength": 128 }
        }
      },
      "anyOf": [
        { "required": ["text"] },
        { "required": ["selected_option_keys"] }
      ]
    }
  }
}
