{
  "$defs": {
    "FlowAssessmentResponse": {
      "additionalProperties": false,
      "description": "既存の四段階 readiness を全 Blueprint の現在状態として保持する。",
      "properties": {
        "level": {
          "enum": [
            "GUIDANCE_ONLY",
            "CONFIGURATION_REQUIRED",
            "RUNNABLE",
            "ACTIONABLE"
          ],
          "title": "Level",
          "type": "string"
        },
        "requirements": {
          "items": {
            "$ref": "#/$defs/FlowRequirementAssessmentResponse"
          },
          "maxItems": 50,
          "title": "Requirements",
          "type": "array"
        }
      },
      "required": [
        "level",
        "requirements"
      ],
      "title": "FlowAssessmentResponse",
      "type": "object"
    },
    "FlowCandidateResponse": {
      "additionalProperties": false,
      "description": "候補の公開ラベルだけを返し、接続情報・Secret・scope は公開しない。",
      "properties": {
        "key": {
          "minLength": 1,
          "title": "Key",
          "type": "string"
        },
        "kind": {
          "minLength": 1,
          "title": "Kind",
          "type": "string"
        },
        "label": {
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "provider": {
          "minLength": 1,
          "title": "Provider",
          "type": "string"
        }
      },
      "required": [
        "key",
        "kind",
        "provider",
        "label"
      ],
      "title": "FlowCandidateResponse",
      "type": "object"
    },
    "FlowContractFieldResponse": {
      "additionalProperties": false,
      "description": "入力・出力 field の原 required を保持し、画面側の既定値で増やさない。",
      "properties": {
        "description": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "enum": {
          "items": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              }
            ]
          },
          "maxItems": 50,
          "minItems": 1,
          "title": "Enum",
          "type": "array",
          "uniqueItems": true
        },
        "fields": {
          "items": {
            "$ref": "#/$defs/FlowContractFieldResponse"
          },
          "maxItems": 100,
          "title": "Fields",
          "type": "array"
        },
        "items": {
          "$ref": "#/$defs/FlowContractItemResponse"
        },
        "key": {
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "title": "Key",
          "type": "string"
        },
        "max_length": {
          "maximum": 100000,
          "minimum": 0,
          "title": "Max Length",
          "type": "integer"
        },
        "maximum": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "number"
            }
          ],
          "title": "Maximum"
        },
        "min_length": {
          "maximum": 100000,
          "minimum": 0,
          "title": "Min Length",
          "type": "integer"
        },
        "minimum": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "number"
            }
          ],
          "title": "Minimum"
        },
        "pattern": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Pattern",
          "type": "string"
        },
        "required": {
          "title": "Required",
          "type": "boolean"
        },
        "type": {
          "enum": [
            "object",
            "array",
            "string",
            "integer",
            "number",
            "boolean"
          ],
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "key",
        "required"
      ],
      "title": "FlowContractFieldResponse",
      "type": "object"
    },
    "FlowContractItemResponse": {
      "additionalProperties": false,
      "description": "既存 TaskContractDraft の再帰値を明示 field だけへ写す。",
      "properties": {
        "description": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "enum": {
          "items": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              }
            ]
          },
          "maxItems": 50,
          "minItems": 1,
          "title": "Enum",
          "type": "array",
          "uniqueItems": true
        },
        "fields": {
          "items": {
            "$ref": "#/$defs/FlowContractFieldResponse"
          },
          "maxItems": 100,
          "title": "Fields",
          "type": "array"
        },
        "items": {
          "$ref": "#/$defs/FlowContractItemResponse"
        },
        "max_length": {
          "maximum": 100000,
          "minimum": 0,
          "title": "Max Length",
          "type": "integer"
        },
        "maximum": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "number"
            }
          ],
          "title": "Maximum"
        },
        "min_length": {
          "maximum": 100000,
          "minimum": 0,
          "title": "Min Length",
          "type": "integer"
        },
        "minimum": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "number"
            }
          ],
          "title": "Minimum"
        },
        "pattern": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Pattern",
          "type": "string"
        },
        "type": {
          "enum": [
            "object",
            "array",
            "string",
            "integer",
            "number",
            "boolean"
          ],
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type"
      ],
      "title": "FlowContractItemResponse",
      "type": "object"
    },
    "FlowContractResponse": {
      "additionalProperties": false,
      "description": "保存された任意業務契約の版を明記し、公開 task 専用 Schema を補造しない。",
      "properties": {
        "contract_version": {
          "const": "skillmind.task-contract-draft/v1",
          "title": "Contract Version",
          "type": "string"
        },
        "description": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "enum": {
          "items": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              }
            ]
          },
          "maxItems": 50,
          "minItems": 1,
          "title": "Enum",
          "type": "array",
          "uniqueItems": true
        },
        "fields": {
          "items": {
            "$ref": "#/$defs/FlowContractFieldResponse"
          },
          "maxItems": 100,
          "title": "Fields",
          "type": "array"
        },
        "items": {
          "$ref": "#/$defs/FlowContractItemResponse"
        },
        "max_length": {
          "maximum": 100000,
          "minimum": 0,
          "title": "Max Length",
          "type": "integer"
        },
        "maximum": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "number"
            }
          ],
          "title": "Maximum"
        },
        "min_length": {
          "maximum": 100000,
          "minimum": 0,
          "title": "Min Length",
          "type": "integer"
        },
        "minimum": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "number"
            }
          ],
          "title": "Minimum"
        },
        "pattern": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Pattern",
          "type": "string"
        },
        "type": {
          "enum": [
            "object",
            "array",
            "string",
            "integer",
            "number",
            "boolean"
          ],
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "contract_version"
      ],
      "title": "FlowContractResponse",
      "type": "object"
    },
    "FlowDeliverableResponse": {
      "additionalProperties": false,
      "description": "予定交付物だけを表示し、Artifact の保存やダウンロード成功を示さない。",
      "properties": {
        "description": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "key": {
          "maxLength": 128,
          "pattern": "^[a-z][a-z0-9_.-]*$",
          "title": "Key",
          "type": "string"
        },
        "kind": {
          "enum": [
            "report",
            "structured_data",
            "patch",
            "change_proposal",
            "artifact"
          ],
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "key",
        "kind",
        "description"
      ],
      "title": "FlowDeliverableResponse",
      "type": "object"
    },
    "FlowEffectResponse": {
      "additionalProperties": false,
      "description": "原効果意図を表示し、承認や外部 apply の成功に変換しない。",
      "properties": {
        "approval_mode": {
          "const": "ask",
          "title": "Approval Mode",
          "type": "string"
        },
        "key": {
          "maxLength": 128,
          "pattern": "^[a-z][a-z0-9_.-]*$",
          "title": "Key",
          "type": "string"
        },
        "mode": {
          "enum": [
            "observe",
            "propose",
            "apply"
          ],
          "title": "Mode",
          "type": "string"
        },
        "operation": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Operation",
          "type": "string"
        },
        "resource_key": {
          "maxLength": 128,
          "pattern": "^[a-z][a-z0-9_.-]*$",
          "title": "Resource Key",
          "type": "string"
        },
        "risk": {
          "enum": [
            "low",
            "medium",
            "high"
          ],
          "title": "Risk",
          "type": "string"
        }
      },
      "required": [
        "key",
        "mode",
        "operation",
        "risk"
      ],
      "title": "FlowEffectResponse",
      "type": "object"
    },
    "FlowExecutionPreferencesResponse": {
      "additionalProperties": false,
      "description": "実行推奨は表示だけとし、Run profile や停止証明として利用しない。",
      "properties": {
        "recommended_profile": {
          "enum": [
            "GUIDED",
            "SUPERVISED",
            "DELEGATED"
          ],
          "title": "Recommended Profile",
          "type": "string"
        },
        "session_split_hints": {
          "items": {
            "$ref": "#/$defs/FlowNoteResponse"
          },
          "maxItems": 100,
          "title": "Session Split Hints",
          "type": "array"
        },
        "stop_conditions": {
          "items": {
            "$ref": "#/$defs/FlowNoteResponse"
          },
          "maxItems": 100,
          "title": "Stop Conditions",
          "type": "array"
        }
      },
      "title": "FlowExecutionPreferencesResponse",
      "type": "object"
    },
    "FlowGuidanceResponse": {
      "additionalProperties": false,
      "description": "必須・推奨・品質・禁止を混ぜず、Skill 共通の原 guidance を表示する。",
      "properties": {
        "prohibited_actions": {
          "items": {
            "$ref": "#/$defs/FlowNoteResponse"
          },
          "maxItems": 100,
          "title": "Prohibited Actions",
          "type": "array"
        },
        "quality_criteria": {
          "items": {
            "$ref": "#/$defs/FlowNoteResponse"
          },
          "maxItems": 100,
          "title": "Quality Criteria",
          "type": "array"
        },
        "recommended_steps": {
          "items": {
            "$ref": "#/$defs/FlowNoteResponse"
          },
          "maxItems": 100,
          "title": "Recommended Steps",
          "type": "array"
        },
        "required_rules": {
          "items": {
            "$ref": "#/$defs/FlowNoteResponse"
          },
          "maxItems": 100,
          "title": "Required Rules",
          "type": "array"
        }
      },
      "title": "FlowGuidanceResponse",
      "type": "object"
    },
    "FlowIdentityResponse": {
      "additionalProperties": false,
      "description": "表示対象を原 Project・SkillVersion・Task・Manifest へ精確に固定する。",
      "properties": {
        "manifest_checksum": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Manifest Checksum",
          "type": "string"
        },
        "project_id": {
          "format": "uuid",
          "title": "Project Id",
          "type": "string"
        },
        "skill_id": {
          "format": "uuid",
          "title": "Skill Id",
          "type": "string"
        },
        "skill_key": {
          "maxLength": 128,
          "pattern": "^[a-z][a-z0-9_.-]*$",
          "title": "Skill Key",
          "type": "string"
        },
        "skill_version_id": {
          "format": "uuid",
          "title": "Skill Version Id",
          "type": "string"
        },
        "task_id": {
          "format": "uuid",
          "title": "Task Id",
          "type": "string"
        },
        "task_key": {
          "maxLength": 128,
          "pattern": "^[a-z][a-z0-9_.-]*$",
          "title": "Task Key",
          "type": "string"
        },
        "version": {
          "maxLength": 32,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "project_id",
        "skill_id",
        "skill_version_id",
        "task_id",
        "task_key",
        "skill_key",
        "version",
        "manifest_checksum"
      ],
      "title": "FlowIdentityResponse",
      "type": "object"
    },
    "FlowInteractionResponse": {
      "additionalProperties": false,
      "description": "予定確認点だけを表示し、OPEN や受理済みなどの持久待办を作らない。",
      "properties": {
        "condition": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Condition",
          "type": "string"
        },
        "key": {
          "maxLength": 128,
          "pattern": "^[a-z][a-z0-9_.-]*$",
          "title": "Key",
          "type": "string"
        },
        "prompt": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Prompt",
          "type": "string"
        },
        "type": {
          "enum": [
            "CLARIFICATION",
            "CHOICE",
            "REVIEW",
            "EFFECT_APPROVAL"
          ],
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "key",
        "type",
        "condition"
      ],
      "title": "FlowInteractionResponse",
      "type": "object"
    },
    "FlowNoteResponse": {
      "additionalProperties": false,
      "description": "原 guidance の識別子と本文だけを表示する。",
      "properties": {
        "key": {
          "maxLength": 128,
          "pattern": "^[a-z][a-z0-9_.-]*$",
          "title": "Key",
          "type": "string"
        },
        "text": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "key",
        "text"
      ],
      "title": "FlowNoteResponse",
      "type": "object"
    },
    "FlowPlanResponse": {
      "additionalProperties": false,
      "description": "既存 Blueprint の read-only 構造であり、新たな DAG やノード実行器ではない。",
      "properties": {
        "shared": {
          "$ref": "#/$defs/FlowSharedResponse"
        },
        "task": {
          "$ref": "#/$defs/FlowTaskEntryResponse"
        },
        "task_resources": {
          "items": {
            "$ref": "#/$defs/FlowResourceEntryResponse"
          },
          "maxItems": 50,
          "title": "Task Resources",
          "type": "array"
        }
      },
      "required": [
        "task",
        "task_resources",
        "shared"
      ],
      "title": "FlowPlanResponse",
      "type": "object"
    },
    "FlowQuestionResponse": {
      "additionalProperties": false,
      "description": "解釈が残した質問と原 required を、そのまま未知情報として示す。",
      "properties": {
        "key": {
          "maxLength": 128,
          "pattern": "^[a-z][a-z0-9_.-]*$",
          "title": "Key",
          "type": "string"
        },
        "required": {
          "title": "Required",
          "type": "boolean"
        },
        "text": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "key",
        "text",
        "required"
      ],
      "title": "FlowQuestionResponse",
      "type": "object"
    },
    "FlowReadinessResponse": {
      "additionalProperties": false,
      "description": "未配線なら null のままにし、計画 checksum と現在の候補を分離する。",
      "properties": {
        "assessment": {
          "anyOf": [
            {
              "$ref": "#/$defs/FlowAssessmentResponse"
            },
            {
              "type": "null"
            }
          ]
        },
        "scope": {
          "const": "SKILL_BLUEPRINT",
          "title": "Scope",
          "type": "string"
        }
      },
      "required": [
        "scope",
        "assessment"
      ],
      "title": "FlowReadinessResponse",
      "type": "object"
    },
    "FlowRequirementAssessmentResponse": {
      "additionalProperties": false,
      "description": "候補と不足理由を現時点の資源照合として返し、実行済みとは表示しない。",
      "properties": {
        "access": {
          "enum": [
            "read",
            "write"
          ],
          "title": "Access",
          "type": "string"
        },
        "candidates": {
          "items": {
            "$ref": "#/$defs/FlowCandidateResponse"
          },
          "title": "Candidates",
          "type": "array"
        },
        "capabilities": {
          "items": {
            "pattern": "^[a-z][a-z0-9_.-]*/v[1-9][0-9]*$",
            "type": "string"
          },
          "maxItems": 20,
          "title": "Capabilities",
          "type": "array"
        },
        "key": {
          "maxLength": 128,
          "pattern": "^[a-z][a-z0-9_.-]*$",
          "title": "Key",
          "type": "string"
        },
        "kind": {
          "enum": [
            "issue",
            "repository",
            "document",
            "file",
            "knowledge",
            "other"
          ],
          "title": "Kind",
          "type": "string"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "required": {
          "title": "Required",
          "type": "boolean"
        },
        "selection_guidance": {
          "anyOf": [
            {
              "maxLength": 1000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Selection Guidance"
        },
        "status": {
          "enum": [
            "AVAILABLE",
            "UNAVAILABLE",
            "UNSUPPORTED"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "key",
        "kind",
        "required",
        "access",
        "status",
        "reason",
        "capabilities",
        "selection_guidance",
        "candidates"
      ],
      "title": "FlowRequirementAssessmentResponse",
      "type": "object"
    },
    "FlowResourceEntryResponse": {
      "additionalProperties": false,
      "description": "資源要求の原位置と Task/Skill 適用範囲を保持する。",
      "properties": {
        "blueprint_ref": {
          "pattern": "^/resource_requirements/(0|[1-9][0-9]*)$",
          "title": "Blueprint Ref",
          "type": "string"
        },
        "scope": {
          "enum": [
            "TASK",
            "SKILL"
          ],
          "title": "Scope",
          "type": "string"
        },
        "value": {
          "$ref": "#/$defs/FlowResourceResponse"
        }
      },
      "required": [
        "scope",
        "blueprint_ref",
        "value"
      ],
      "title": "FlowResourceEntryResponse",
      "type": "object"
    },
    "FlowResourceResponse": {
      "additionalProperties": false,
      "description": "原資源要求は要求として表示し、候補選択やアクセス済み事実に読み替えない。",
      "properties": {
        "accepted_providers": {
          "items": {
            "maxLength": 128,
            "pattern": "^[a-z][a-z0-9_.-]*$",
            "type": "string"
          },
          "maxItems": 20,
          "title": "Accepted Providers",
          "type": "array"
        },
        "access": {
          "enum": [
            "read",
            "write"
          ],
          "title": "Access",
          "type": "string"
        },
        "capabilities": {
          "items": {
            "pattern": "^[a-z][a-z0-9_.-]*/v[1-9][0-9]*$",
            "type": "string"
          },
          "maxItems": 20,
          "title": "Capabilities",
          "type": "array"
        },
        "key": {
          "maxLength": 128,
          "pattern": "^[a-z][a-z0-9_.-]*$",
          "title": "Key",
          "type": "string"
        },
        "kind": {
          "enum": [
            "issue",
            "repository",
            "document",
            "file",
            "knowledge",
            "other"
          ],
          "title": "Kind",
          "type": "string"
        },
        "required": {
          "title": "Required",
          "type": "boolean"
        },
        "selection_guidance": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Selection Guidance",
          "type": "string"
        }
      },
      "required": [
        "key",
        "kind",
        "required",
        "access"
      ],
      "title": "FlowResourceResponse",
      "type": "object"
    },
    "FlowSharedResponse": {
      "additionalProperties": false,
      "description": "Task 専用と偽らず、全 Skill の共通規則・確認・効果を別区画に残す。",
      "properties": {
        "assumptions": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/FlowNoteResponse"
              },
              "maxItems": 100,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "title": "Assumptions"
        },
        "effect_intents": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/FlowEffectResponse"
              },
              "maxItems": 50,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "title": "Effect Intents"
        },
        "execution_preferences": {
          "anyOf": [
            {
              "$ref": "#/$defs/FlowExecutionPreferencesResponse"
            },
            {
              "type": "null"
            }
          ]
        },
        "guidance": {
          "anyOf": [
            {
              "$ref": "#/$defs/FlowGuidanceResponse"
            },
            {
              "type": "null"
            }
          ]
        },
        "interaction_points": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/FlowInteractionResponse"
              },
              "maxItems": 50,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "title": "Interaction Points"
        },
        "questions": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/FlowQuestionResponse"
              },
              "maxItems": 50,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "title": "Questions"
        },
        "resource_requirements": {
          "items": {
            "$ref": "#/$defs/FlowResourceEntryResponse"
          },
          "maxItems": 50,
          "title": "Resource Requirements",
          "type": "array"
        },
        "scope": {
          "const": "SKILL",
          "title": "Scope",
          "type": "string"
        }
      },
      "required": [
        "scope",
        "resource_requirements",
        "guidance",
        "interaction_points",
        "effect_intents",
        "assumptions",
        "questions",
        "execution_preferences"
      ],
      "title": "FlowSharedResponse",
      "type": "object"
    },
    "FlowTaskEntryResponse": {
      "additionalProperties": false,
      "description": "選択 Task と原 Blueprint 内の位置を明示する。",
      "properties": {
        "blueprint_ref": {
          "pattern": "^/tasks/(0|[1-9][0-9]*)$",
          "title": "Blueprint Ref",
          "type": "string"
        },
        "scope": {
          "const": "TASK",
          "title": "Scope",
          "type": "string"
        },
        "value": {
          "$ref": "#/$defs/FlowTaskResponse"
        }
      },
      "required": [
        "scope",
        "blueprint_ref",
        "value"
      ],
      "title": "FlowTaskEntryResponse",
      "type": "object"
    },
    "FlowTaskResponse": {
      "additionalProperties": false,
      "description": "選択した原 Task の field を保持し、欠けた任意項目は補完しない。",
      "properties": {
        "capability": {
          "maxLength": 128,
          "pattern": "^[a-z][a-z0-9_.-]*$",
          "title": "Capability",
          "type": "string"
        },
        "deliverables": {
          "items": {
            "$ref": "#/$defs/FlowDeliverableResponse"
          },
          "maxItems": 50,
          "title": "Deliverables",
          "type": "array"
        },
        "document_prerequisites": {
          "items": {
            "maxLength": 128,
            "pattern": "^[a-z][a-z0-9_.-]*$",
            "type": "string"
          },
          "maxItems": 50,
          "minItems": 1,
          "title": "Document Prerequisites",
          "type": "array",
          "uniqueItems": true
        },
        "key": {
          "maxLength": 128,
          "pattern": "^[a-z][a-z0-9_.-]*$",
          "title": "Key",
          "type": "string"
        },
        "objective": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Objective",
          "type": "string"
        },
        "parameter_contract": {
          "$ref": "#/$defs/FlowContractResponse"
        },
        "resource_keys": {
          "items": {
            "maxLength": 128,
            "pattern": "^[a-z][a-z0-9_.-]*$",
            "type": "string"
          },
          "maxItems": 50,
          "title": "Resource Keys",
          "type": "array"
        },
        "result_contract": {
          "$ref": "#/$defs/FlowContractResponse"
        },
        "success_criteria": {
          "items": {
            "$ref": "#/$defs/FlowNoteResponse"
          },
          "maxItems": 50,
          "title": "Success Criteria",
          "type": "array"
        }
      },
      "required": [
        "key",
        "capability",
        "objective"
      ],
      "title": "FlowTaskResponse",
      "type": "object"
    },
    "FlowTraceResponse": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "verification": {
                "const": "SOURCE_INDEX"
              }
            },
            "required": [
              "verification"
            ]
          },
          "then": {
            "properties": {
              "line": {
                "type": "null"
              }
            }
          }
        }
      ],
      "description": "検証範囲を持つ原 trace を返し、binary 取得や意味的な正しさは主張しない。",
      "properties": {
        "line": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Line"
        },
        "path": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "reason": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "target": {
          "maxLength": 512,
          "pattern": "^/",
          "title": "Target",
          "type": "string"
        },
        "verification": {
          "enum": [
            "SOURCE_INDEX",
            "TEXT_SNAPSHOT"
          ],
          "title": "Verification",
          "type": "string"
        }
      },
      "required": [
        "target",
        "path",
        "line",
        "reason",
        "verification"
      ],
      "title": "FlowTraceResponse",
      "type": "object"
    }
  },
  "$id": "https://schemas.skillmind.local/tasks/flow-preview/v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "else": {
        "properties": {
          "blueprint_checksum": {
            "type": "null"
          },
          "plan": {
            "type": "null"
          },
          "readiness": {
            "properties": {
              "assessment": {
                "type": "null"
              }
            }
          },
          "source_traces": {
            "maxItems": 0
          }
        }
      },
      "if": {
        "properties": {
          "status": {
            "const": "AVAILABLE"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "blueprint_checksum": {
            "type": "string"
          },
          "plan": {
            "type": "object"
          },
          "source_traces": {
            "minItems": 1
          }
        }
      }
    }
  ],
  "description": "新しい read-only preview の完全な公開 shape。Run の frozen plan ではない。",
  "properties": {
    "blueprint_checksum": {
      "anyOf": [
        {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Blueprint Checksum"
    },
    "identity": {
      "$ref": "#/$defs/FlowIdentityResponse"
    },
    "plan": {
      "anyOf": [
        {
          "$ref": "#/$defs/FlowPlanResponse"
        },
        {
          "type": "null"
        }
      ]
    },
    "preview_checksum": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Preview Checksum",
      "type": "string"
    },
    "preview_version": {
      "const": "skillmind.task-flow-preview/v1",
      "title": "Preview Version",
      "type": "string"
    },
    "readiness": {
      "$ref": "#/$defs/FlowReadinessResponse"
    },
    "source_traces": {
      "items": {
        "$ref": "#/$defs/FlowTraceResponse"
      },
      "maxItems": 500,
      "title": "Source Traces",
      "type": "array"
    },
    "status": {
      "enum": [
        "AVAILABLE",
        "NOT_DECLARED"
      ],
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "preview_version",
    "identity",
    "status",
    "blueprint_checksum",
    "preview_checksum",
    "plan",
    "source_traces",
    "readiness"
  ],
  "title": "TaskFlowPreviewResponse",
  "type": "object"
}
