{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.skillmind.local/events/run-event/v1.schema.json",
  "title": "Skillmind RunEvent v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["run_id", "run_attempt_id", "sequence", "event_type", "occurred_at", "payload"],
  "properties": {
    "run_id": { "type": "string", "format": "uuid" },
    "run_attempt_id": { "type": ["string", "null"], "format": "uuid" },
    "agent_session_id": { "type": ["string", "null"], "format": "uuid" },
    "sequence": { "type": "integer", "minimum": 1 },
    "event_type": {
      "enum": [
        "RUN_SNAPSHOT",
        "RUN_CANCEL_REQUESTED",
        "SESSION_STARTED",
        "STEP_STARTED",
        "STEP_COMPLETED",
        "STEP_FAILED",
        "TEXT_DELTA",
        "TEXT_COMPLETED",
        "TOOL_REQUESTED",
        "TOOL_COMPLETED",
        "TOOL_FAILED",
        "PERMISSION_REQUIRED",
        "PERMISSION_RESOLVED",
        "EVIDENCE_CREATED",
        "ARTIFACT_CREATED",
        "USAGE_UPDATED",
        "SESSION_DEFERRED",
        "SESSION_INTERRUPTED",
        "SESSION_STORE_DEGRADED",
        "SEGMENT_STARTED",
        "SEGMENT_COMPLETED",
        "INTERACTION_REQUESTED",
        "INTERACTION_RESPONDED",
        "INTERACTION_EXPIRED",
        "CHECKPOINT_CREATED",
        "SESSION_RESUMED",
        "SESSION_FORKED",
        "SESSION_REPLACED",
        "CHANGE_PROPOSED",
        "EFFECT_APPROVED",
        "EFFECT_REJECTED",
        "EFFECT_APPLIED",
        "EFFECT_FAILED",
        "RESULT_COMPLETED",
        "ENGINE_FAILED"
      ]
    },
    "occurred_at": { "type": "string", "format": "date-time" },
    "payload": { "type": "object" },
    "trace_id": { "type": ["string", "null"], "maxLength": 64 }
  }
}
