{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.skillmind.local/events/skill-interpret-event/v1.schema.json",
  "title": "Skillmind SkillInterpretEvent v1",
  "description": "Skill interpret/adjust の非永続な進行 event。SSE 表示専用で正本は skill_interpretations。",
  "type": "object",
  "additionalProperties": false,
  "required": ["event", "execution_key", "occurred_at", "data"],
  "properties": {
    "event": {
      "enum": [
        "interpret.queued",
        "interpret.started",
        "interpret.prompt",
        "interpret.delta",
        "interpret.completed",
        "interpret.failed"
      ]
    },
    "execution_key": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "occurred_at": { "type": "string", "format": "date-time" },
    "data": { "type": "object" }
  }
}
