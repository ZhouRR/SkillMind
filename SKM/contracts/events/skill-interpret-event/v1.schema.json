{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.skillmind.local/events/skill-interpret-event/v1.schema.json",
  "title": "Skillmind SkillInterpretEvent v1",
  "description": "Skill 解釈の進行通知。要求/結果の正本は DB。SSE 終態は原要求から再確認し、disconnected は持久 FAILED を意味しない。",
  "type": "object",
  "additionalProperties": false,
  "required": ["event", "execution_key", "occurred_at", "data"],
  "properties": {
    "event": {
      "enum": [
        "interpret.queued",
        "interpret.started",
        "interpret.prompt",
        "interpret.delta",
        "interpret.completed",
        "interpret.failed",
        "interpret.unknown",
        "interpret.disconnected"
      ]
    },
    "execution_key": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "occurred_at": { "type": "string", "format": "date-time" },
    "data": { "type": "object" }
  }
}
