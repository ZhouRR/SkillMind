{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.skillmind.local/task-contract-draft/v1.schema.json",
  "title": "Skillmind TaskContractDraft v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "type"],
  "properties": {
    "contract_version": { "const": "skillmind.task-contract-draft/v1" },
    "type": { "$ref": "#/$defs/valueType" },
    "description": { "$ref": "#/$defs/description" },
    "enum": { "$ref": "#/$defs/enumValues" },
    "fields": {
      "type": "array",
      "maxItems": 100,
      "items": { "$ref": "#/$defs/field" }
    },
    "items": { "$ref": "#/$defs/item" },
    "min_length": { "$ref": "#/$defs/stringLength" },
    "max_length": { "$ref": "#/$defs/stringLength" },
    "pattern": { "type": "string", "minLength": 1, "maxLength": 128 },
    "minimum": { "type": "number" },
    "maximum": { "type": "number" }
  },
  "$defs": {
    "valueType": {
      "enum": ["object", "array", "string", "integer", "number", "boolean"]
    },
    "description": { "type": "string", "minLength": 1, "maxLength": 500 },
    "stringLength": { "type": "integer", "minimum": 0, "maximum": 100000 },
    "enumValues": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "uniqueItems": true,
      "items": { "type": ["string", "integer", "number", "boolean"] }
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "type", "required"],
      "properties": {
        "key": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$" },
        "type": { "$ref": "#/$defs/valueType" },
        "required": { "type": "boolean" },
        "description": { "$ref": "#/$defs/description" },
        "enum": { "$ref": "#/$defs/enumValues" },
        "fields": {
          "type": "array",
          "maxItems": 100,
          "items": { "$ref": "#/$defs/field" }
        },
        "items": { "$ref": "#/$defs/item" },
        "min_length": { "$ref": "#/$defs/stringLength" },
        "max_length": { "$ref": "#/$defs/stringLength" },
        "pattern": { "type": "string", "minLength": 1, "maxLength": 128 },
        "minimum": { "type": "number" },
        "maximum": { "type": "number" }
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "$ref": "#/$defs/valueType" },
        "description": { "$ref": "#/$defs/description" },
        "enum": { "$ref": "#/$defs/enumValues" },
        "fields": {
          "type": "array",
          "maxItems": 100,
          "items": { "$ref": "#/$defs/field" }
        },
        "items": { "$ref": "#/$defs/item" },
        "min_length": { "$ref": "#/$defs/stringLength" },
        "max_length": { "$ref": "#/$defs/stringLength" },
        "pattern": { "type": "string", "minLength": 1, "maxLength": 128 },
        "minimum": { "type": "number" },
        "maximum": { "type": "number" }
      }
    }
  }
}
