{
  "contract_version": "skillmind.task-contract-draft/v1",
  "type": "object",
  "description": "Repository review request",
  "fields": [
    {
      "key": "target_path",
      "type": "string",
      "required": true,
      "description": "Path to review",
      "min_length": 1,
      "max_length": 1024
    },
    {
      "key": "review_modes",
      "type": "array",
      "required": false,
      "description": "Requested review modes",
      "items": {
        "type": "string",
        "enum": ["correctness", "maintainability", "security"]
      }
    }
  ]
}
