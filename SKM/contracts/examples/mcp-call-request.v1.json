{
  "name": "open_application",
  "arguments": {
    "appId": "sample",
    "requestId": "${effect_id}"
  },
  "catalog_hash": "sha256:1111111111111111111111111111111111111111111111111111111111111111",
  "read_back": {
    "name": "get_step_status",
    "arguments": {
      "requestId": "${effect_id}"
    },
    "checks": [
      {
        "path": "/requestId",
        "equals": "${effect_id}"
      },
      {
        "path": "/status",
        "one_of": [
          "READY",
          "COMPLETED",
          "ERROR",
          "TIMEOUT",
          "CANCELLED",
          "ABORTED"
        ]
      }
    ]
  }
}
