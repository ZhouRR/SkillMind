{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.skillmind.local/tools/issue.read/v1/response.schema.json",
  "title": "issue.read/v1 response",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "provider", "issue", "evidence_refs", "warnings", "truncated"],
  "properties": {
    "status": { "const": "success" },
    "provider": { "enum": ["csv", "redmine"] },
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "subject", "description", "status", "updated_at", "fields", "extensions"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "subject": { "type": "string" },
        "description": { "type": ["string", "null"] },
        "status": { "type": ["string", "null"] },
        "updated_at": { "type": ["string", "null"], "format": "date-time" },
        "fields": { "type": "object" },
        "extensions": { "type": "object" }
      }
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^ev_[a-zA-Z0-9_-]+$" },
      "uniqueItems": true
    },
    "warnings": { "type": "array", "items": { "type": "string" } },
    "truncated": { "type": "boolean" }
  }
}

