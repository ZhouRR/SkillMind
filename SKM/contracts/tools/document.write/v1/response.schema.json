{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.skillmind.local/tools/document.write/v1/response.schema.json",
  "title": "document.write/v1 response",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "provider",
    "before_ref",
    "after_ref",
    "verification",
    "replayed"
  ],
  "properties": {
    "status": {
      "const": "success"
    },
    "provider": {
      "const": "project-library"
    },
    "proposal_ref": {
      "type": "string",
      "pattern": "^cp_[a-zA-Z0-9_-]+$"
    },
    "before_ref": {
      "type": "string",
      "pattern": "^ev_[a-zA-Z0-9_-]+$"
    },
    "after_ref": {
      "type": "string",
      "pattern": "^ev_[a-zA-Z0-9_-]+$"
    },
    "verification": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "method",
        "matched_paths"
      ],
      "properties": {
        "method": {
          "const": "READ_BACK"
        },
        "matched_paths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "replayed": {
      "type": "boolean"
    }
  }
}
