{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.skillmind.local/tools/artifact.append/v1/response.schema.json",
  "title": "artifact.append/v1 response",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "provider",
    "path",
    "content_hash",
    "bytes_written",
    "created",
    "evidence_refs",
    "artifact_refs",
    "source_artifact_ref",
    "source_content_hash",
    "source_bytes",
    "appended_bytes",
    "append_hash"
  ],
  "properties": {
    "status": {
      "const": "success"
    },
    "provider": {
      "const": "platform"
    },
    "path": {
      "type": "string",
      "minLength": 8,
      "maxLength": 4096,
      "pattern": "^output/"
    },
    "content_hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "bytes_written": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1048576
    },
    "created": {
      "type": "boolean"
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "string",
        "maxLength": 64,
        "pattern": "^ev_[a-zA-Z0-9_-]+$"
      },
      "uniqueItems": true
    },
    "artifact_refs": {
      "type": "array",
      "maxItems": 1,
      "items": {
        "type": "string",
        "maxLength": 64,
        "pattern": "^art_[a-zA-Z0-9_-]+$"
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "source_artifact_ref": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^art_[a-zA-Z0-9_-]+$"
    },
    "source_content_hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "source_bytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1048576
    },
    "appended_bytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65536
    },
    "append_hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  }
}
