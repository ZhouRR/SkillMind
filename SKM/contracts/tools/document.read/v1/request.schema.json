{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.skillmind.local/tools/document.read/v1/request.schema.json",
  "title": "document.read/v1 request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "purpose"
  ],
  "properties": {
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "description": "Project-relative file path. Selected task inputs retain frozen bytes; additional project documents are readable only under the frozen project-wide grant."
    },
    "line_start": {
      "type": "integer",
      "minimum": 1
    },
    "line_end": {
      "type": "integer",
      "minimum": 1
    },
    "purpose": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "response_mode": {
      "type": "string",
      "enum": [
        "inline",
        "file"
      ],
      "default": "inline"
    },
    "document_id": {
      "type": "string",
      "format": "uuid",
      "description": "Exact document ID in this Project, including an ID from an upload receipt."
    },
    "expected_hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$",
      "description": "Require the exact document bytes observed or confirmed in an upload receipt."
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "response_mode"
        ],
        "properties": {
          "response_mode": {
            "const": "file"
          }
        }
      },
      "then": {
        "not": {
          "anyOf": [
            {
              "required": [
                "line_start"
              ]
            },
            {
              "required": [
                "line_end"
              ]
            }
          ]
        }
      }
    }
  ],
  "oneOf": [
    {
      "required": [
        "path"
      ]
    },
    {
      "required": [
        "document_id"
      ]
    }
  ]
}
