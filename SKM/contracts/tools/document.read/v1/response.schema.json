{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.skillmind.local/tools/document.read/v1/response.schema.json",
  "title": "document.read/v1 response",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "provider",
    "document",
    "evidence_refs",
    "warnings",
    "truncated"
  ],
  "properties": {
    "status": {
      "const": "success"
    },
    "provider": {
      "enum": [
        "project"
      ]
    },
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "folder",
        "name",
        "mime",
        "checksum",
        "size"
      ],
      "properties": {
        "folder": {
          "type": "string"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "mime": {
          "type": "string",
          "minLength": 1
        },
        "checksum": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "size": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "content": {
      "type": "string"
    },
    "line_start": {
      "type": "integer",
      "minimum": 1
    },
    "line_end": {
      "type": "integer",
      "minimum": 0
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^ev_[a-zA-Z0-9_-]+$"
      },
      "uniqueItems": true
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "truncated": {
      "type": "boolean"
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "content_hash",
        "size_bytes"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^workspace/documents/",
          "maxLength": 4096
        },
        "content_hash": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  },
  "oneOf": [
    {
      "required": [
        "content",
        "line_start",
        "line_end"
      ],
      "not": {
        "required": [
          "file"
        ]
      }
    },
    {
      "required": [
        "file"
      ],
      "properties": {
        "truncated": {
          "const": false
        }
      },
      "not": {
        "anyOf": [
          {
            "required": [
              "content"
            ]
          },
          {
            "required": [
              "line_start"
            ]
          },
          {
            "required": [
              "line_end"
            ]
          }
        ]
      }
    }
  ]
}
