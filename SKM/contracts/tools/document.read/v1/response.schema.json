{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.skillmind.local/tools/document.read/v1/response.schema.json",
  "title": "document.read/v1 response",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "provider",
    "document",
    "content",
    "line_start",
    "line_end",
    "evidence_refs",
    "warnings",
    "truncated"
  ],
  "properties": {
    "status": { "const": "success" },
    "provider": { "enum": ["project"] },
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": ["folder", "name", "mime", "checksum", "size"],
      "properties": {
        "folder": { "type": "string" },
        "name": { "type": "string", "minLength": 1 },
        "mime": { "type": "string", "minLength": 1 },
        "checksum": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "size": { "type": "integer", "minimum": 0 }
      }
    },
    "content": { "type": "string" },
    "line_start": { "type": "integer", "minimum": 1 },
    "line_end": { "type": "integer", "minimum": 0 },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^ev_[a-zA-Z0-9_-]+$" },
      "uniqueItems": true
    },
    "warnings": { "type": "array", "items": { "type": "string" } },
    "truncated": { "type": "boolean" }
  }
}
