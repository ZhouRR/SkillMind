{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.skillmind.local/tools/repository.read/v1/response.schema.json",
  "title": "repository.read/v1 response",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "provider",
        "revision",
        "path",
        "content",
        "content_hash",
        "evidence_refs",
        "warnings",
        "truncated"
      ],
      "properties": {
        "status": {
          "const": "success"
        },
        "provider": {
          "enum": [
            "git",
            "svn"
          ]
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "content": {
          "type": "string",
          "maxLength": 200000
        },
        "content_hash": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "line_start": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "line_end": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^ev_[a-zA-Z0-9_-]+$"
          },
          "uniqueItems": true
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "truncated": {
          "type": "boolean"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "const": "success"
        },
        "provider": {
          "enum": [
            "git",
            "svn",
            "mcp"
          ]
        },
        "file": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string",
              "pattern": "^workspace/resources/"
            },
            "content_hash": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            },
            "size_bytes": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "path",
            "content_hash",
            "size_bytes"
          ]
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^ev_"
          }
        }
      },
      "required": [
        "status",
        "provider",
        "file",
        "evidence_refs"
      ]
    }
  ]
}
