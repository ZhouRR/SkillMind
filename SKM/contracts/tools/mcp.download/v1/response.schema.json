{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "provider",
    "evidence_refs",
    "file",
    "content_type",
    "source_evidence_ref"
  ],
  "properties": {
    "status": {
      "const": "success"
    },
    "provider": {
      "const": "mcp"
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^ev_[a-zA-Z0-9_-]+$"
      }
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "content_hash",
        "size_bytes"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^workspace/resources/"
        },
        "content_hash": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16777216
        }
      }
    },
    "content_type": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 512
    },
    "source_evidence_ref": {
      "type": "string",
      "pattern": "^ev_[a-zA-Z0-9_-]+$"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.skillmind.local/tools/mcp.download/v1/response.schema.json",
  "title": "mcp.download/v1 response"
}
