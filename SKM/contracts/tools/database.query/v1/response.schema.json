{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "status": {
      "const": "success"
    },
    "provider": {
      "const": "postgres"
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^workspace/resources/"
        },
        "content_hash": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "path",
        "content_hash",
        "size_bytes"
      ]
    },
    "row_count": {
      "type": "integer",
      "minimum": 0
    },
    "truncated": {
      "type": "boolean"
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^ev_"
      }
    }
  },
  "required": [
    "status",
    "provider",
    "file",
    "row_count",
    "truncated",
    "evidence_refs"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.skillmind.local/tools/database.query/v1/response.schema.json",
  "title": "database.query/v1 response"
}
