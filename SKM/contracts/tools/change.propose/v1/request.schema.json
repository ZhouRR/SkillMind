{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.skillmind.local/tools/change.propose/v1/request.schema.json",
  "title": "change.propose/v1 request",
  "$defs": {
    "key": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]*$",
      "maxLength": 128
    },
    "checkpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary",
        "confirmed_facts",
        "evidence_refs",
        "artifact_refs",
        "change_proposal_refs"
      ],
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "confirmed_facts": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        },
        "evidence_refs": {
          "type": "array",
          "maxItems": 200,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^ev_[a-zA-Z0-9_-]+$"
          }
        },
        "artifact_refs": {
          "type": "array",
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^art_[a-zA-Z0-9_-]+$"
          }
        },
        "change_proposal_refs": {
          "type": "array",
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^cp_[a-zA-Z0-9_-]+$"
          }
        }
      }
    }
  },
  "type": "object",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resource_key",
        "capability_version",
        "operation",
        "target",
        "changes",
        "summary"
      ],
      "properties": {
        "effect_intent_key": {
          "$ref": "#/$defs/key"
        },
        "resource_key": {
          "$ref": "#/$defs/key"
        },
        "capability_version": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]*/[vV][0-9][a-zA-Z0-9_.-]*$",
          "maxLength": 128
        },
        "operation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "target": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "locator",
            "display"
          ],
          "properties": {
            "locator": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "display": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            }
          }
        },
        "changes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "action",
              "value"
            ],
            "properties": {
              "path": {
                "type": "string",
                "pattern": "^/[^\\x00-\\x1f\\x7f]+$",
                "maxLength": 512
              },
              "action": {
                "enum": [
                  "SET",
                  "REMOVE",
                  "APPEND"
                ]
              },
              "value": {}
            }
          }
        },
        "precondition": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "revision": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          }
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 0,
          "maxItems": 200,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^ev_[a-zA-Z0-9_-]+$"
          }
        },
        "risk_level": {
          "enum": [
            "LOW",
            "MEDIUM",
            "HIGH"
          ]
        },
        "reversible": {
          "type": "boolean"
        },
        "rollback": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "description"
          ],
          "properties": {
            "description": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            }
          }
        },
        "verification": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "method",
            "paths"
          ],
          "properties": {
            "method": {
              "enum": [
                "READ_BACK",
                "HTTP_RESPONSE",
                "SQL_RESPONSE"
              ]
            },
            "paths": {
              "type": "array",
              "minItems": 1,
              "maxItems": 50,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^/[^\\x00-\\x1f\\x7f]+$",
                "maxLength": 512
              }
            }
          }
        },
        "idempotency_key": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{7,127}$"
        },
        "expires_in_seconds": {
          "type": "integer",
          "minimum": 300,
          "maximum": 86400
        },
        "continuation_mode": {
          "enum": [
            "RESUME",
            "FORK",
            "REPLACE"
          ]
        },
        "checkpoint": {
          "$ref": "#/$defs/checkpoint"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "capability_version": {
                "enum": [
                  "http.write/v1",
                  "database.execute/v1"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "precondition": {
                "maxProperties": 0
              }
            }
          },
          "else": {
            "required": [
              "precondition",
              "evidence_refs"
            ],
            "properties": {
              "precondition": {
                "required": [
                  "revision"
                ]
              },
              "evidence_refs": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "capability_version": {
                "const": "http.write/v1"
              }
            }
          },
          "then": {
            "properties": {
              "verification": {
                "properties": {
                  "method": {
                    "const": "HTTP_RESPONSE"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "capability_version": {
                "const": "database.execute/v1"
              }
            }
          },
          "then": {
            "properties": {
              "verification": {
                "properties": {
                  "method": {
                    "const": "SQL_RESPONSE"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "capability_version": {
                "not": {
                  "enum": [
                    "http.write/v1",
                    "database.execute/v1"
                  ]
                }
              }
            }
          },
          "then": {
            "properties": {
              "verification": {
                "properties": {
                  "method": {
                    "const": "READ_BACK"
                  }
                }
              }
            }
          }
        }
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "request_file": {
          "type": "string",
          "pattern": "^(workspace|output)/"
        },
        "expected_hash": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 0,
          "maxItems": 200,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^ev_[a-zA-Z0-9_-]+$"
          }
        }
      },
      "required": [
        "request_file",
        "expected_hash"
      ]
    }
  ]
}
