{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.skillmind.local/tools/document.inspect/v1/response.schema.json",
  "title": "document.inspect/v1 response",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "provider",
    "document",
    "storage",
    "observed_at",
    "content_verified",
    "observation_checksum",
    "evidence_refs",
    "warnings"
  ],
  "properties": {
    "status": {
      "const": "success"
    },
    "provider": {
      "const": "project"
    },
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "document_id",
        "folder",
        "name",
        "mime",
        "size",
        "content_hash"
      ],
      "properties": {
        "document_id": {
          "type": "string",
          "format": "uuid"
        },
        "folder": {
          "type": "string"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "mime": {
          "type": "string",
          "minLength": 1
        },
        "size": {
          "type": "integer",
          "minimum": 0
        },
        "content_hash": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$",
          "description": "Declared frozen document hash; not verified by inspection."
        }
      }
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "last_modified",
        "version_id",
        "etag",
        "size",
        "content_type"
      ],
      "properties": {
        "last_modified": {
          "type": "string",
          "format": "date-time"
        },
        "version_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 1024
        },
        "etag": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "size": {
          "type": "integer",
          "minimum": 0
        },
        "content_type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "content_verified": {
      "const": false
    },
    "observation_checksum": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^ev_[a-zA-Z0-9_-]+$"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source_object_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "description": "Exact source object key from the authorized project document storage reference. Not a user-supplied path, URL or permission. Absent from historical responses and sources that do not expose it. A new verified acquisition may return it even when using a legacy observation."
    }
  }
}
