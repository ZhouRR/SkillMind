{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "provider",
    "table",
    "rows",
    "read_at",
    "truncated",
    "content_hash",
    "evidence_refs",
    "warnings"
  ],
  "properties": {
    "status": {
      "const": "success"
    },
    "provider": {
      "const": "postgres"
    },
    "table": {
      "type": "string",
      "pattern": "^[a-zA-Z_][a-zA-Z0-9_$]{0,62}\\.[a-zA-Z_][a-zA-Z0-9_$]{0,62}$"
    },
    "rows": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object"
      }
    },
    "read_at": {
      "type": "string",
      "format": "date-time"
    },
    "truncated": {
      "type": "boolean"
    },
    "content_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^ev_[a-zA-Z0-9_-]+$"
      },
      "uniqueItems": true
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$id": "https://schemas.skillmind.local/tools/database.read/v1/response.schema.json",
  "title": "database.read/v1 response"
}
