{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "table",
    "purpose"
  ],
  "properties": {
    "table": {
      "type": "string",
      "pattern": "^[a-zA-Z_][a-zA-Z0-9_$]{0,62}\\.[a-zA-Z_][a-zA-Z0-9_$]{0,62}$"
    },
    "columns": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-zA-Z_][a-zA-Z0-9_$]{0,62}$"
      },
      "maxItems": 100,
      "uniqueItems": true
    },
    "filters": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-zA-Z_][a-zA-Z0-9_$]{0,62}$"
      },
      "maxProperties": 20,
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "boolean",
          "null"
        ],
        "maxLength": 2000
      }
    },
    "order_by": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-zA-Z_][a-zA-Z0-9_$]{0,62}$"
      },
      "maxItems": 100,
      "uniqueItems": true
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "offset": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10000
    },
    "purpose": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    }
  },
  "$id": "https://schemas.skillmind.local/tools/database.read/v1/request.schema.json",
  "title": "database.read/v1 request"
}
