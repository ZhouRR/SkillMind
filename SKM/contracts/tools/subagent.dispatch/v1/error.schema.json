{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.skillmind.local/tools/subagent.dispatch/v1/error.schema.json",
  "title": "subagent.dispatch/v1 error",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "code", "message", "retryable"],
  "properties": {
    "status": { "const": "error" },
    "code": {
      "enum": [
        "invalid_request",
        "capability_not_granted",
        "nesting_not_allowed",
        "budget_exhausted",
        "unavailable"
      ]
    },
    "message": { "type": "string", "minLength": 1, "maxLength": 500 },
    "retryable": { "type": "boolean" }
  }
}
