{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.skillmind.local/tools/http.write/v1/response.schema.json",
  "title": "http.write/v1 response",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "provider",
    "before_ref",
    "after_ref",
    "verification",
    "replayed"
  ],
  "properties": {
    "status": {
      "const": "success"
    },
    "provider": {
      "const": "http"
    },
    "proposal_ref": {
      "type": "string",
      "pattern": "^cp_[a-zA-Z0-9_-]+$"
    },
    "before_ref": {
      "type": "string",
      "pattern": "^ev_[a-zA-Z0-9_-]+$"
    },
    "after_ref": {
      "type": "string",
      "pattern": "^ev_[a-zA-Z0-9_-]+$"
    },
    "verification": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "method",
        "matched_paths",
        "http_status",
        "headers",
        "file"
      ],
      "properties": {
        "method": {
          "const": "HTTP_RESPONSE"
        },
        "matched_paths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "http_status": {
          "type": "integer",
          "minimum": 200,
          "maximum": 299
        },
        "headers": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "file": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "size_bytes",
            "content_hash"
          ],
          "properties": {
            "path": {
              "type": "string",
              "pattern": "^workspace/"
            },
            "size_bytes": {
              "type": "integer",
              "minimum": 0
            },
            "content_hash": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            }
          }
        }
      }
    },
    "replayed": {
      "type": "boolean"
    }
  }
}
