{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "provider",
    "source_artifact_ref",
    "file",
    "evidence_refs"
  ],
  "properties": {
    "status": {
      "const": "success"
    },
    "provider": {
      "const": "platform"
    },
    "source_artifact_ref": {
      "type": "string",
      "pattern": "^art_[a-zA-Z0-9_-]+$",
      "maxLength": 64
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "content_hash",
        "size_bytes",
        "total_lines"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^workspace/",
          "maxLength": 4096
        },
        "content_hash": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1048576
        },
        "total_lines": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^ev_[a-zA-Z0-9_-]+$"
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.skillmind.local/tools/artifact.materialize/v1/response.schema.json",
  "title": "artifact.materialize/v1 response"
}
