{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.skillmind.local/tools/repository.write/v1/request.schema.json",
  "title": "repository.write/v1 request",
  "type": "object",
  "additionalProperties": false,
  "required": ["target_branch", "changes", "base_revision", "commit_message", "idempotency_key"],
  "properties": {
    "target_branch": {
      "type": "string",
      "pattern": "^skillmind/[A-Za-z0-9][A-Za-z0-9._/-]{0,110}$",
      "description": "Platform-reserved branch namespace. The provider never writes to an existing or default branch."
    },
    "changes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "action", "value"],
        "properties": {
          "path": { "type": "string", "pattern": "^/files/[A-Za-z0-9][A-Za-z0-9._/-]{0,4000}$" },
          "action": { "enum": ["SET", "REMOVE"] },
          "value": { "type": ["string", "null"], "maxLength": 1048576 }
        }
      }
    },
    "base_revision": { "type": "string", "minLength": 1, "maxLength": 256 },
    "commit_message": { "type": "string", "minLength": 1, "maxLength": 4000 },
    "idempotency_key": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{7,127}$"
    }
  }
}
