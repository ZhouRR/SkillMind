{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.skillmind.local/tools/issue.update/v1/request.schema.json",
  "title": "issue.update/v1 request",
  "type": "object",
  "additionalProperties": false,
  "required": ["target_locator", "changes", "expected_revision", "idempotency_key"],
  "properties": {
    "target_locator": { "type": "string", "pattern": "^[1-9][0-9]{0,17}$" },
    "changes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "action", "value"],
        "properties": {
          "path": { "type": "string", "pattern": "^/fields/[a-zA-Z0-9_.-]+$" },
          "action": { "const": "SET" },
          "value": {}
        }
      }
    },
    "expected_revision": { "type": "string", "minLength": 1, "maxLength": 256 },
    "idempotency_key": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{7,127}$"
    }
  }
}
