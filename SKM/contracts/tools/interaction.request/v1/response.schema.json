{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.skillmind.local/tools/interaction.request/v1/response.schema.json",
  "title": "interaction.request/v1 response",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "deferred"],
  "properties": {
    "status": { "const": "success" },
    "deferred": { "type": "boolean" },
    "interaction_id": { "type": "string", "format": "uuid" },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "text": { "type": "string", "minLength": 1, "maxLength": 10000 },
        "selected_option_keys": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]*$", "maxLength": 128 }
        }
      }
    },
    "continuation_prompt": { "type": "string", "minLength": 1 },
    "task_brief_checksum": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^ev_[a-zA-Z0-9_-]+$" }
    }
  }
}
