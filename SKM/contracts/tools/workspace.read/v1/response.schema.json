{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.skillmind.local/tools/workspace.read/v1/response.schema.json",
  "title": "workspace.read/v1 response",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "provider",
    "path",
    "content",
    "content_hash",
    "line_start",
    "line_end",
    "evidence_refs",
    "warnings",
    "truncated"
  ],
  "properties": {
    "status": {
      "const": "success"
    },
    "provider": {
      "const": "workspace"
    },
    "path": {
      "type": "string",
      "minLength": 1
    },
    "content": {
      "type": "string",
      "maxLength": 200000
    },
    "content_hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "line_start": {
      "type": "integer",
      "minimum": 1
    },
    "line_end": {
      "type": "integer",
      "minimum": 0
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^ev_[a-zA-Z0-9_-]+$"
      },
      "uniqueItems": true
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "truncated": {
      "type": "boolean"
    },
    "offset": {
      "type": "integer",
      "minimum": 0
    },
    "next_offset": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "total_chars": {
      "type": "integer",
      "minimum": 0
    }
  },
  "dependentRequired": {
    "offset": [
      "offset",
      "next_offset",
      "total_chars"
    ],
    "next_offset": [
      "offset",
      "next_offset",
      "total_chars"
    ],
    "total_chars": [
      "offset",
      "next_offset",
      "total_chars"
    ]
  }
}
