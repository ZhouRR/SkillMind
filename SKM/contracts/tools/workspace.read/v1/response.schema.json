{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.skillmind.local/tools/workspace.read/v1/response.schema.json",
  "title": "workspace.read/v1 response",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "provider",
    "path",
    "content_hash",
    "evidence_refs",
    "warnings",
    "truncated"
  ],
  "properties": {
    "status": {
      "const": "success"
    },
    "provider": {
      "const": "workspace"
    },
    "path": {
      "type": "string",
      "minLength": 1
    },
    "content": {
      "type": "string",
      "maxLength": 200000
    },
    "content_hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "line_start": {
      "type": "integer",
      "minimum": 1
    },
    "line_end": {
      "type": "integer",
      "minimum": 0
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^ev_[a-zA-Z0-9_-]+$"
      },
      "uniqueItems": true
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "truncated": {
      "type": "boolean"
    },
    "offset": {
      "type": "integer",
      "minimum": 0
    },
    "next_offset": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "total_chars": {
      "type": "integer",
      "minimum": 0
    },
    "format": {
      "const": "json"
    },
    "selections": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "pointer",
          "exists"
        ],
        "properties": {
          "pointer": {
            "type": "string",
            "maxLength": 2048
          },
          "exists": {
            "type": "boolean"
          },
          "value": {},
          "offset": {
            "type": "integer",
            "minimum": 0
          },
          "next_offset": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "total_items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "exists": {
                  "const": true
                }
              }
            },
            "then": {
              "required": [
                "value"
              ]
            },
            "else": {
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "value"
                    ]
                  },
                  {
                    "required": [
                      "offset"
                    ]
                  },
                  {
                    "required": [
                      "next_offset"
                    ]
                  },
                  {
                    "required": [
                      "total_items"
                    ]
                  }
                ]
              }
            }
          }
        ],
        "dependentRequired": {
          "offset": [
            "offset",
            "next_offset",
            "total_items"
          ],
          "next_offset": [
            "offset",
            "next_offset",
            "total_items"
          ],
          "total_items": [
            "offset",
            "next_offset",
            "total_items"
          ]
        }
      }
    }
  },
  "dependentRequired": {
    "offset": [
      "offset",
      "next_offset",
      "total_chars"
    ],
    "next_offset": [
      "offset",
      "next_offset",
      "total_chars"
    ],
    "total_chars": [
      "offset",
      "next_offset",
      "total_chars"
    ]
  },
  "oneOf": [
    {
      "required": [
        "content",
        "line_start",
        "line_end"
      ],
      "not": {
        "anyOf": [
          {
            "required": [
              "selections"
            ]
          },
          {
            "required": [
              "format"
            ]
          }
        ]
      }
    },
    {
      "required": [
        "format",
        "selections"
      ],
      "not": {
        "anyOf": [
          {
            "required": [
              "content"
            ]
          },
          {
            "required": [
              "line_start"
            ]
          },
          {
            "required": [
              "line_end"
            ]
          },
          {
            "required": [
              "offset"
            ]
          },
          {
            "required": [
              "next_offset"
            ]
          },
          {
            "required": [
              "total_chars"
            ]
          }
        ]
      }
    }
  ]
}
