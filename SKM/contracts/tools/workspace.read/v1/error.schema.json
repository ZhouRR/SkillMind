{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.skillmind.local/tools/workspace.read/v1/error.schema.json",
  "title": "workspace.read/v1 error",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "code", "message", "retryable"],
  "properties": {
    "status": { "const": "error" },
    "code": { "enum": ["invalid_request", "not_found", "too_large", "unavailable"] },
    "message": { "type": "string", "minLength": 1, "maxLength": 500 },
    "retryable": { "type": "boolean" }
  }
}
