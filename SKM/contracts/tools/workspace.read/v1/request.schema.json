{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.skillmind.local/tools/workspace.read/v1/request.schema.json",
  "title": "workspace.read/v1 request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "path",
    "purpose"
  ],
  "properties": {
    "path": {
      "type": "string",
      "minLength": 7,
      "maxLength": 4096,
      "pattern": "^(?:input|workspace|output)/",
      "not": {
        "pattern": "(^/|(^|/)\\.\\.(/|$))"
      }
    },
    "line_start": {
      "type": "integer",
      "minimum": 1
    },
    "line_end": {
      "type": "integer",
      "minimum": 1
    },
    "purpose": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "offset": {
      "type": "integer",
      "minimum": 0,
      "description": "Zero-based Unicode character offset; use next_offset for continuation."
    },
    "max_chars": {
      "type": "integer",
      "minimum": 1,
      "maximum": 200000,
      "default": 64000,
      "description": "Unicode characters per page. Defaults to 64000; increase up to 200000 for broad reading when context allows, or reduce for focused lookups."
    },
    "expected_hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$",
      "description": "Reject changed file bytes; use the hash from conversion or materialization."
    },
    "pointers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "maxLength": 2048,
        "pattern": "^(?:/(?:[^~/]|~[01])*)*$"
      },
      "description": "Read exact RFC 6901 paths from JSON; absent differs from null/false. Requires expected_hash. Do not mix text paging."
    },
    "array_offset": {
      "type": "integer",
      "minimum": 0,
      "default": 0,
      "description": "Starting item for each selected JSON array."
    },
    "array_limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 200,
      "default": 20,
      "description": "Items per selected JSON array. Continue with that selection next_offset."
    }
  },
  "allOf": [
    {
      "if": {
        "anyOf": [
          {
            "required": [
              "offset"
            ]
          },
          {
            "required": [
              "max_chars"
            ]
          }
        ]
      },
      "then": {
        "not": {
          "anyOf": [
            {
              "required": [
                "line_start"
              ]
            },
            {
              "required": [
                "line_end"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "required": [
          "pointers"
        ]
      },
      "then": {
        "required": [
          "expected_hash"
        ],
        "not": {
          "anyOf": [
            {
              "required": [
                "offset"
              ]
            },
            {
              "required": [
                "max_chars"
              ]
            },
            {
              "required": [
                "line_start"
              ]
            },
            {
              "required": [
                "line_end"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "anyOf": [
          {
            "required": [
              "array_offset"
            ]
          },
          {
            "required": [
              "array_limit"
            ]
          }
        ]
      },
      "then": {
        "required": [
          "pointers"
        ]
      }
    }
  ]
}
