{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "$id": "https://schemas.skillmind.local/tools/tool.sequence/v1/request.schema.json",
  "title": "tool.sequence/v1 request",
  "required": [
    "steps",
    "purpose"
  ],
  "properties": {
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "capability",
          "arguments"
        ],
        "properties": {
          "capability": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]*/v[0-9][a-zA-Z0-9_.-]*$",
            "maxLength": 128
          },
          "arguments": {
            "type": "object"
          },
          "checks": {
            "type": "array",
            "maxItems": 10,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "pointer",
                "equals"
              ],
              "properties": {
                "pointer": {
                  "type": "string",
                  "maxLength": 512,
                  "pattern": "^(?:/(?:[^~/]|~[01])*)*$"
                },
                "equals": {}
              }
            }
          }
        }
      }
    },
    "purpose": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    }
  }
}
