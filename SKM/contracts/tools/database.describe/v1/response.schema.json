{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "provider",
    "table",
    "table_schema",
    "observed_at",
    "schema_checksum",
    "cached",
    "observation_refs",
    "evidence_refs",
    "warnings"
  ],
  "properties": {
    "status": {
      "const": "success"
    },
    "provider": {
      "const": "postgres"
    },
    "table": {
      "type": "string",
      "pattern": "^[a-zA-Z_][a-zA-Z0-9_$]{0,62}\\.[a-zA-Z_][a-zA-Z0-9_$]{0,62}$"
    },
    "table_schema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "columns",
        "primary_key"
      ],
      "description": "Exact observed structure; original observation time and evidence are retained on reuse. Not proof of current DDL or write permission.",
      "properties": {
        "columns": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "data_type",
              "not_null",
              "has_default",
              "generated",
              "identity"
            ],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-zA-Z_][a-zA-Z0-9_$]{0,62}$"
              },
              "data_type": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              },
              "not_null": {
                "type": "boolean",
                "description": "Column NOT NULL flag; does not describe domain or check constraints."
              },
              "has_default": {
                "type": "boolean"
              },
              "generated": {
                "type": "boolean"
              },
              "identity": {
                "enum": [
                  "NONE",
                  "ALWAYS",
                  "BY_DEFAULT"
                ]
              }
            }
          }
        },
        "primary_key": {
          "type": "array",
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-zA-Z_][a-zA-Z0-9_$]{0,62}$"
          }
        }
      }
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^ev_[a-zA-Z0-9_-]+$"
      },
      "uniqueItems": true
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "schema_checksum": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "cached": {
      "type": "boolean"
    },
    "observation_refs": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "string",
        "pattern": "^ev_[a-zA-Z0-9_-]+$"
      }
    }
  },
  "$id": "https://schemas.skillmind.local/tools/database.describe/v1/response.schema.json",
  "title": "database.describe/v1 response"
}
