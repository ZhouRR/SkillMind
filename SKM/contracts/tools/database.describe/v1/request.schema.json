{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "table",
    "purpose"
  ],
  "properties": {
    "table": {
      "type": "string",
      "pattern": "^[a-zA-Z_][a-zA-Z0-9_$]{0,62}\\.[a-zA-Z_][a-zA-Z0-9_$]{0,62}$"
    },
    "purpose": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "refresh": {
      "type": "boolean",
      "default": false
    },
    "recovery_from": {
      "type": "string",
      "format": "uuid"
    },
    "resource_key": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]*$",
      "maxLength": 128,
      "description": "This Run's frozen resource slot key. Required when several resources provide this capability; omit only when exactly one is available. Does not grant access or accept a connection address."
    }
  },
  "$id": "https://schemas.skillmind.local/tools/database.describe/v1/request.schema.json",
  "title": "database.describe/v1 request"
}
