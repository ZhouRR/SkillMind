{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "description": "Approved native PostgreSQL DML only. change.propose target.locator=database, operation=INSERT/UPDATE/DELETE, one SET /statement value={statement:{sql,parameters?},read_back:{sql,parameters?,limit?},checks:[{pointer,equals}]}. precondition.revision is the prior database.query response file hash. Transaction includes SQL, read-back and original Effect receipt. No DDL, transaction commands, multiple statements or automatic unknown-result replay. Table/column permissions are enforced by the configured database account.",
  "properties": {
    "statement": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sql": {
          "type": "string",
          "minLength": 1,
          "maxLength": 65536
        },
        "parameters": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "type": [
              "string",
              "number",
              "boolean",
              "null"
            ]
          }
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "purpose": {
          "type": "string",
          "maxLength": 2000
        }
      },
      "required": [
        "sql"
      ]
    },
    "read_back": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sql": {
          "type": "string",
          "minLength": 1,
          "maxLength": 65536
        },
        "parameters": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "type": [
              "string",
              "number",
              "boolean",
              "null"
            ]
          }
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "purpose": {
          "type": "string",
          "maxLength": 2000
        }
      },
      "required": [
        "sql"
      ]
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "pointer": {
            "type": "string",
            "pattern": "^(?:/(?:[^~/]|~[01])*)*$"
          },
          "equals": {}
        },
        "required": [
          "pointer",
          "equals"
        ]
      }
    },
    "operation": {
      "enum": [
        "INSERT",
        "UPDATE",
        "DELETE"
      ]
    }
  },
  "required": [
    "statement",
    "read_back",
    "checks",
    "operation"
  ],
  "$id": "https://schemas.skillmind.local/tools/database.execute/v1/request.schema.json",
  "title": "database.execute/v1 request"
}
