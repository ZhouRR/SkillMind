{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.skillmind.local/tools/document.readiness/v1/error.schema.json",
  "title": "document.readiness/v1 error",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "code",
    "message",
    "retryable"
  ],
  "properties": {
    "status": {
      "const": "error"
    },
    "code": {
      "enum": [
        "not_found",
        "unavailable",
        "scope_denied",
        "invalid_request"
      ]
    },
    "message": {
      "type": "string",
      "minLength": 1
    },
    "retryable": {
      "type": "boolean"
    }
  }
}
