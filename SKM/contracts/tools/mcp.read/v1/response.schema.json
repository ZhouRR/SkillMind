{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "provider",
    "read_at",
    "content_hash",
    "evidence_refs",
    "uri",
    "contents"
  ],
  "properties": {
    "status": {
      "const": "success"
    },
    "provider": {
      "const": "mcp"
    },
    "read_at": {
      "type": "string",
      "format": "date-time"
    },
    "content_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^ev_[a-zA-Z0-9_-]+$"
      },
      "uniqueItems": true
    },
    "uri": {
      "type": "string",
      "format": "uri",
      "minLength": 1,
      "maxLength": 2048
    },
    "contents": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "uri"
        ],
        "properties": {
          "uri": {
            "type": "string",
            "format": "uri",
            "minLength": 1,
            "maxLength": 2048
          },
          "mime_type": {
            "type": "string",
            "maxLength": 200
          },
          "text": {
            "type": "string"
          },
          "blob": {
            "type": "string",
            "contentEncoding": "base64"
          }
        },
        "oneOf": [
          {
            "required": [
              "text"
            ],
            "not": {
              "required": [
                "blob"
              ]
            }
          },
          {
            "required": [
              "blob"
            ],
            "not": {
              "required": [
                "text"
              ]
            }
          }
        ]
      }
    }
  },
  "$id": "https://schemas.skillmind.local/tools/mcp.read/v1/response.schema.json",
  "title": "mcp.read/v1 response"
}
