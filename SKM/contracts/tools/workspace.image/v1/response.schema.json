{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "provider",
    "evidence_refs",
    "image"
  ],
  "properties": {
    "status": {
      "const": "success"
    },
    "provider": {
      "const": "workspace"
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^ev_[a-zA-Z0-9_-]+$"
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "content_hash",
        "size_bytes",
        "mime_type",
        "width",
        "height"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^(input|workspace|output)/"
        },
        "content_hash": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8388608
        },
        "mime_type": {
          "enum": [
            "image/png",
            "image/jpeg",
            "image/webp"
          ]
        },
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 25000000
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 25000000
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.skillmind.local/tools/workspace.image/v1/response.schema.json",
  "title": "workspace.image/v1 response"
}
