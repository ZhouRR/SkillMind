{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.skillmind.local/agent-task-brief/v1.schema.json",
  "title": "Skillmind AgentTaskBrief v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "brief_version",
    "identity",
    "objective",
    "guidance",
    "execution",
    "resources",
    "allowed_tools",
    "effect_policy",
    "interaction_policy",
    "checkpoint",
    "deliverables",
    "limits"
  ],
  "properties": {
    "brief_version": {
      "const": "skillmind.agent-task-brief/v1"
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "segment_no",
        "task_key",
        "capability",
        "skill_version_id",
        "manifest_checksum",
        "blueprint_checksum",
        "result_schema_checksum"
      ],
      "properties": {
        "run_id": {
          "type": "string",
          "format": "uuid"
        },
        "segment_no": {
          "type": "integer",
          "minimum": 1
        },
        "task_key": {
          "$ref": "#/$defs/key"
        },
        "capability": {
          "$ref": "#/$defs/domainCapability"
        },
        "skill_version_id": {
          "type": "string",
          "format": "uuid"
        },
        "manifest_checksum": {
          "$ref": "#/$defs/sha256"
        },
        "blueprint_checksum": {
          "$ref": "#/$defs/sha256"
        },
        "result_schema_checksum": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "objective": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_objective",
        "segment_objective",
        "success_criteria"
      ],
      "properties": {
        "run_objective": {
          "$ref": "#/$defs/text"
        },
        "segment_objective": {
          "$ref": "#/$defs/text"
        },
        "success_criteria": {
          "$ref": "#/$defs/noteList"
        }
      }
    },
    "guidance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required_rules",
        "recommended_steps",
        "quality_criteria",
        "prohibited_actions"
      ],
      "properties": {
        "required_rules": {
          "$ref": "#/$defs/noteList"
        },
        "recommended_steps": {
          "$ref": "#/$defs/noteList"
        },
        "quality_criteria": {
          "$ref": "#/$defs/noteList"
        },
        "prohibited_actions": {
          "$ref": "#/$defs/noteList"
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "profile_source",
        "stop_conditions",
        "session_split_hints"
      ],
      "properties": {
        "profile": {
          "enum": [
            "GUIDED",
            "SUPERVISED",
            "DELEGATED"
          ]
        },
        "profile_source": {
          "enum": [
            "platform_default",
            "skill_recommendation",
            "platform_maximum"
          ]
        },
        "stop_conditions": {
          "$ref": "#/$defs/noteList"
        },
        "session_split_hints": {
          "$ref": "#/$defs/noteList"
        }
      }
    },
    "resources": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "kind",
          "required",
          "access",
          "capabilities",
          "binding"
        ],
        "properties": {
          "key": {
            "$ref": "#/$defs/key"
          },
          "kind": {
            "$ref": "#/$defs/resourceKind"
          },
          "required": {
            "type": "boolean"
          },
          "access": {
            "enum": [
              "read",
              "write"
            ]
          },
          "capabilities": {
            "type": "array",
            "maxItems": 20,
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/versionedCapability"
            }
          },
          "selection_guidance": {
            "$ref": "#/$defs/text"
          },
          "binding": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "capability",
                  "provider",
                  "binding_source"
                ],
                "properties": {
                  "capability": {
                    "$ref": "#/$defs/versionedCapability"
                  },
                  "provider": {
                    "$ref": "#/$defs/key"
                  },
                  "binding_source": {
                    "enum": [
                      "RUN_PREFLIGHT"
                    ]
                  }
                }
              }
            ]
          },
          "materialization": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "root",
              "manifest",
              "index",
              "materialized_files",
              "skipped_files"
            ],
            "properties": {
              "root": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              "manifest": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              "index": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              "history": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              "revision": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "materialized_files": {
                "type": "integer",
                "minimum": 0
              },
              "skipped_files": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      }
    },
    "allowed_tools": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "capability",
          "provider",
          "read_only"
        ],
        "properties": {
          "capability": {
            "$ref": "#/$defs/versionedCapability"
          },
          "provider": {
            "$ref": "#/$defs/key"
          },
          "read_only": {
            "type": "boolean"
          }
        }
      }
    },
    "effect_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "external_write",
        "network_scope",
        "declared_intents"
      ],
      "properties": {
        "external_write": {
          "enum": [
            "deny"
          ]
        },
        "network_scope": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "declared_intents": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "key",
              "mode",
              "operation",
              "risk",
              "executable"
            ],
            "properties": {
              "key": {
                "$ref": "#/$defs/key"
              },
              "mode": {
                "enum": [
                  "observe",
                  "propose",
                  "apply"
                ]
              },
              "resource_key": {
                "$ref": "#/$defs/key"
              },
              "operation": {
                "$ref": "#/$defs/text"
              },
              "risk": {
                "enum": [
                  "low",
                  "medium",
                  "high"
                ]
              },
              "executable": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    "interaction_policy": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "type",
          "condition"
        ],
        "properties": {
          "key": {
            "$ref": "#/$defs/key"
          },
          "type": {
            "enum": [
              "CLARIFICATION",
              "CHOICE",
              "REVIEW",
              "EFFECT_APPROVAL"
            ]
          },
          "condition": {
            "$ref": "#/$defs/text"
          },
          "prompt": {
            "$ref": "#/$defs/text"
          }
        }
      }
    },
    "checkpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary",
        "confirmed_facts",
        "user_responses",
        "evidence_refs",
        "artifact_refs",
        "change_proposal_refs"
      ],
      "properties": {
        "summary": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 4000
            }
          ]
        },
        "confirmed_facts": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        },
        "user_responses": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "interaction_id",
              "interaction_type",
              "response",
              "responded_at"
            ],
            "properties": {
              "interaction_id": {
                "type": "string",
                "format": "uuid"
              },
              "interaction_type": {
                "enum": [
                  "CLARIFICATION",
                  "CHOICE",
                  "REVIEW",
                  "EFFECT_APPROVAL"
                ]
              },
              "response": {
                "type": "object"
              },
              "responded_at": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        },
        "evidence_refs": {
          "type": "array",
          "maxItems": 200,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^ev_[a-zA-Z0-9_-]+$"
          }
        },
        "artifact_refs": {
          "type": "array",
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^art_[a-zA-Z0-9_-]+$"
          }
        },
        "change_proposal_refs": {
          "type": "array",
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^cp_[a-zA-Z0-9_-]+$"
          }
        }
      }
    },
    "deliverables": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "kind",
          "description"
        ],
        "properties": {
          "key": {
            "$ref": "#/$defs/key"
          },
          "kind": {
            "enum": [
              "report",
              "structured_data",
              "patch",
              "change_proposal",
              "artifact"
            ]
          },
          "description": {
            "$ref": "#/$defs/text"
          }
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_turns",
        "wall_timeout_seconds",
        "max_output_bytes",
        "max_budget_usd"
      ],
      "properties": {
        "max_turns": {
          "type": "integer",
          "minimum": 1
        },
        "wall_timeout_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "max_output_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "max_budget_usd": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0
        }
      }
    }
  },
  "$defs": {
    "key": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]*$",
      "maxLength": 128
    },
    "domainCapability": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]*(/v[1-9][0-9]*)?$",
      "maxLength": 128
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "versionedCapability": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]*/v[1-9][0-9]*$"
    },
    "resourceKind": {
      "enum": [
        "issue",
        "repository",
        "document",
        "file",
        "knowledge",
        "other"
      ]
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "note": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "text"
      ],
      "properties": {
        "key": {
          "$ref": "#/$defs/key"
        },
        "text": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "noteList": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/note"
      }
    }
  }
}
