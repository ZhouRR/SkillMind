{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.skillmind.local/users/v1/create-request.schema.json",
  "title": "Skillmind User create-request v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "email",
    "display_name",
    "system_role",
    "password"
  ],
  "properties": {
    "email": {
      "type": "string",
      "minLength": 3,
      "maxLength": 320
    },
    "display_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "system_role": {
      "type": "string",
      "enum": [
        "ADMIN",
        "USER"
      ]
    },
    "password": {
      "type": "string",
      "minLength": 15,
      "maxLength": 1024,
      "writeOnly": true
    }
  }
}
