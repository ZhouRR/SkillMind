{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.skillmind.local/users/v1/security-event.schema.json",
  "title": "Skillmind User security-event v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "user_id",
    "actor_id",
    "action",
    "row_version",
    "previous_role",
    "previous_status",
    "system_role",
    "status",
    "revoked_sessions",
    "request_id",
    "created_at"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "user_id": {
      "type": "string",
      "format": "uuid"
    },
    "actor_id": {
      "type": "string",
      "format": "uuid"
    },
    "action": {
      "type": "string",
      "enum": [
        "CREATED",
        "UPDATED",
        "PASSWORD_CHANGED",
        "SESSIONS_REVOKED"
      ]
    },
    "row_version": {
      "type": "integer",
      "minimum": 1
    },
    "previous_role": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "ADMIN",
            "USER"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "previous_status": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "ACTIVE",
            "DISABLED"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "system_role": {
      "type": "string",
      "enum": [
        "ADMIN",
        "USER"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "ACTIVE",
        "DISABLED"
      ]
    },
    "revoked_sessions": {
      "type": "integer",
      "minimum": 0
    },
    "request_id": {
      "type": "string",
      "format": "uuid"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
