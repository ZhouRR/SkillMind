{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.skillmind.local/users/v1/update-request.schema.json",
  "title": "Skillmind User update-request v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "display_name",
    "system_role",
    "status",
    "expected_row_version"
  ],
  "properties": {
    "display_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "system_role": {
      "type": "string",
      "enum": [
        "ADMIN",
        "USER"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "ACTIVE",
        "DISABLED"
      ]
    },
    "expected_row_version": {
      "type": "integer",
      "minimum": 1
    }
  }
}
