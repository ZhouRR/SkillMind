{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.skillmind.local/users/v1/password-request.schema.json",
  "title": "Skillmind User password-request v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "current_password",
    "new_password",
    "expected_row_version"
  ],
  "properties": {
    "current_password": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "writeOnly": true
    },
    "new_password": {
      "type": "string",
      "minLength": 8,
      "maxLength": 1024,
      "writeOnly": true
    },
    "expected_row_version": {
      "type": "integer",
      "minimum": 1
    }
  }
}
