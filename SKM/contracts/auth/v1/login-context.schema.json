{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.skillmind.local/auth/v1/login-context.schema.json",
  "title": "Skillmind Login Context v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["csrf_token", "expires_in_seconds"],
  "properties": {
    "csrf_token": { "type": "string", "minLength": 32 },
    "expires_in_seconds": { "type": "integer", "minimum": 60, "maximum": 900 }
  }
}
