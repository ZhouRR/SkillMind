{
  "$defs": {
    "ApiKeyResponse": {
      "additionalProperties": false,
      "description": "名前と利用・失効時刻だけを投影し、資格 hash と秘密を含めない。",
      "properties": {
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "key_prefix": {
          "title": "Key Prefix",
          "type": "string"
        },
        "created_by": {
          "format": "uuid",
          "title": "Created By",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "last_used_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Last Used At"
        },
        "revoked_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Revoked At"
        }
      },
      "required": [
        "id",
        "name",
        "key_prefix",
        "created_by",
        "created_at",
        "last_used_at",
        "revoked_at"
      ],
      "title": "ApiKeyResponse",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "失効済みを含む組織内の管理一覧。",
  "properties": {
    "items": {
      "items": {
        "$ref": "#/$defs/ApiKeyResponse"
      },
      "title": "Items",
      "type": "array"
    }
  },
  "required": [
    "items"
  ],
  "title": "ApiKeyListResponse",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skillmind.example/contracts/auth/api-keys/v1/api-key-list.schema.json"
}
