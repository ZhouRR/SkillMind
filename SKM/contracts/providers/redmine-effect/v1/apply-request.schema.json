{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.skillmind.local/providers/redmine-effect/v1/apply-request.schema.json",
  "title": "Redmine controlled issue update request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "capability_version",
    "expected_revision",
    "idempotency_key",
    "issue"
  ],
  "properties": {
    "capability_version": { "const": "issue.update/v1" },
    "expected_revision": { "type": "string", "minLength": 1, "maxLength": 256 },
    "idempotency_key": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{7,127}$"
    },
    "issue": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 50
    }
  }
}
