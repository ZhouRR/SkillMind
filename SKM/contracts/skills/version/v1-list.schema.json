{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.skillmind.local/skills/version/v1-list.schema.json",
  "title": "Organization SkillVersion list v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["skill_versions"],
  "properties": {
    "skill_versions": {
      "type": "array",
      "items": { "$ref": "#/$defs/version" }
    }
  },
  "$defs": {
    "version": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "skill_id", "skill_version_id", "skill_source_id", "interpretation_id",
        "organization_id", "skill_key", "name", "description", "version", "status", "manifest_checksum",
        "manifest", "gate_passed", "gate_findings", "interpretation_diff", "created_at",
        "published_by", "published_at"
      ],
      "properties": {
        "skill_id": { "type": "string", "format": "uuid" },
        "skill_version_id": { "type": "string", "format": "uuid" },
        "skill_source_id": { "type": "string", "format": "uuid" },
        "interpretation_id": { "type": "string", "format": "uuid" },
        "organization_id": { "type": "string", "format": "uuid" },
        "skill_key": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "status": { "enum": ["DRAFT", "PUBLISHED", "DEPRECATED"] },
        "manifest_checksum": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "manifest": { "type": "object" },
        "gate_passed": { "type": "boolean" },
        "gate_findings": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["code", "severity", "message", "path"],
            "properties": {
              "code": { "type": "string" },
              "severity": { "enum": ["error", "warning", "info"] },
              "message": { "type": "string" },
              "path": { "type": ["string", "null"] }
            }
          }
        },
        "interpretation_diff": { "type": "object" },
        "created_at": { "type": "string", "format": "date-time" },
        "published_by": { "type": ["string", "null"], "format": "uuid" },
        "published_at": { "type": ["string", "null"], "format": "date-time" }
      }
    }
  }
}
