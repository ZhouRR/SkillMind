{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.skillmind.local/skills/interpreter/v1/static-analysis.schema.json",
  "title": "Skill static analysis v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "analysis_version", "source_hash", "blocked", "references", "scripts", "commands",
    "external_links", "declared_tools", "unsupported_operations", "diagnostics", "checksum"
  ],
  "properties": {
    "analysis_version": { "const": "skillmind.skill-static-analysis/v1" },
    "source_hash": { "$ref": "#/$defs/sha256" },
    "blocked": { "type": "boolean" },
    "references": { "type": "array", "items": { "$ref": "#/$defs/path" }, "uniqueItems": true },
    "scripts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "language"],
        "properties": {
          "path": { "$ref": "#/$defs/path" },
          "language": { "type": "string", "minLength": 1 }
        }
      }
    },
    "commands": {
      "type": "array",
      "items": { "$ref": "#/$defs/locationWithLanguage" }
    },
    "external_links": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "line", "scheme"],
        "properties": {
          "path": { "$ref": "#/$defs/path" },
          "line": { "type": "integer", "minimum": 1 },
          "scheme": { "enum": ["http", "https"] }
        }
      }
    },
    "declared_tools": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "unsupported_operations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "path", "line"],
        "properties": {
          "code": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "path": { "$ref": "#/$defs/path" },
          "line": { "type": ["integer", "null"], "minimum": 1 }
        }
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["severity", "code", "message", "path", "line"],
        "properties": {
          "severity": { "enum": ["error", "warning", "info"] },
          "code": { "type": "string", "pattern": "^[a-z][a-z0-9_.:-]*$" },
          "message": { "type": "string", "minLength": 1, "maxLength": 500 },
          "path": { "type": ["string", "null"] },
          "line": { "type": ["integer", "null"], "minimum": 1 }
        }
      }
    },
    "checksum": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "path": { "type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$" },
    "locationWithLanguage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "line", "language"],
      "properties": {
        "path": { "$ref": "#/$defs/path" },
        "line": { "type": "integer", "minimum": 1 },
        "language": { "type": "string", "minLength": 1 }
      }
    }
  }
}
