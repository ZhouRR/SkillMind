{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.projectmind.local/runs/detail/v1.schema.json",
  "title": "ProjectMind Run detail v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["run_id", "project_id", "task_id", "status", "row_version", "created_at", "input", "selected_sources", "output_schema", "output_schema_checksum", "result", "tool_calls", "evidence", "skill_snapshots", "segments", "attempts", "sessions", "interactions", "change_proposals", "approvals", "effect_executions"],
  "properties": {
    "run_id": { "type": "string", "format": "uuid" },
    "project_id": { "type": "string", "format": "uuid" },
    "task_id": { "type": "string", "format": "uuid" },
    "status": { "enum": ["QUEUED", "PREPARING", "RUNNING", "RETRY_PENDING", "WAITING_PERMISSION", "WAITING_FOR_INPUT", "WAITING_FOR_APPROVAL", "SUCCEEDED", "FAILED", "CANCELLED"] },
    "row_version": { "type": "integer", "minimum": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "input": { "type": "object" },
    "selected_sources": { "type": "object" },
    "output_schema": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["$schema", "type"],
          "properties": {
            "$schema": { "const": "https://json-schema.org/draft/2020-12/schema" },
            "type": { "enum": ["object", "array", "string", "integer", "number", "boolean"] }
          }
        }
      ]
    },
    "output_schema_checksum": {
      "type": ["string", "null"],
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "result": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["result_id", "output_schema", "result_kind", "data", "evidence_refs", "artifact_refs", "change_proposal_refs", "optional_schema_identity", "summary", "confidence", "needs_review", "usage", "cost", "validation", "created_at"],
          "properties": {
            "result_id": { "type": "string", "format": "uuid" },
            "output_schema": { "type": "string", "minLength": 1 },
            "result_kind": { "enum": ["OUTCOME_ENVELOPE", "STRUCTURED_OUTPUT"] },
            "data": { "type": "object" },
            "evidence_refs": {
              "type": "array",
              "uniqueItems": true,
              "items": { "type": "string", "pattern": "^ev_[a-zA-Z0-9_-]+$" }
            },
            "artifact_refs": {
              "type": "array",
              "uniqueItems": true,
              "items": { "type": "string", "pattern": "^art_[a-zA-Z0-9_-]+$" }
            },
            "change_proposal_refs": {
              "type": "array",
              "uniqueItems": true,
              "items": { "type": "string", "pattern": "^cp_[a-zA-Z0-9_-]+$" }
            },
            "optional_schema_identity": { "type": "object" },
            "summary": { "type": "string" },
            "confidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
            "needs_review": { "type": "boolean" },
            "usage": { "type": "object" },
            "cost": { "type": "object" },
            "validation": { "type": "object" },
            "created_at": { "type": "string", "format": "date-time" }
          }
        }
      ]
    },
    "tool_calls": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["tool_call_id", "run_attempt_id", "agent_session_id", "tool_name", "capability", "provider", "arguments_summary", "status", "duration_ms", "created_at"],
        "properties": {
          "tool_call_id": { "type": "string", "format": "uuid" },
          "run_attempt_id": { "type": "string", "format": "uuid" },
          "agent_session_id": { "type": "string", "format": "uuid" },
          "tool_name": { "type": "string" },
          "capability": { "type": "string" },
          "provider": { "type": "string" },
          "arguments_summary": { "type": "object" },
          "status": { "type": "string" },
          "duration_ms": { "type": ["integer", "null"], "minimum": 0 },
          "created_at": { "type": "string", "format": "date-time" }
        }
      }
    },
    "skill_snapshots": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["skill_version_id", "sort_order", "manifest_checksum", "config_snapshot"],
        "properties": {
          "skill_version_id": { "type": "string", "format": "uuid" },
          "sort_order": { "type": "integer", "minimum": 0 },
          "manifest_checksum": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
          "config_snapshot": { "type": "object" }
        }
      }
    },
    "segments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["run_segment_id", "segment_no", "trigger_type", "trigger_ref", "status", "objective", "checkpoint", "continuation_mode", "parent_agent_session_id", "task_brief_checksum", "started_at", "finished_at", "created_at"],
        "properties": {
          "run_segment_id": { "type": ["string", "null"], "format": "uuid" },
          "segment_no": { "type": "integer", "minimum": 1 },
          "trigger_type": { "enum": ["INITIAL", "INTERACTION_RESPONSE", "INTERACTION_TIMEOUT", "APPROVAL_RESPONSE", "APPROVAL_TIMEOUT"] },
          "trigger_ref": { "type": ["string", "null"], "format": "uuid" },
          "status": { "enum": ["CREATED", "RUNNING", "WAITING", "COMPLETED", "FAILED", "CANCELLED"] },
          "objective": { "type": "object" },
          "checkpoint": { "type": "object" },
          "continuation_mode": { "enum": ["INITIAL", "RESUME", "FORK", "REPLACE"] },
          "parent_agent_session_id": { "type": ["string", "null"], "format": "uuid" },
          "task_brief_checksum": { "type": ["string", "null"], "pattern": "^sha256:[a-f0-9]{64}$" },
          "started_at": { "type": ["string", "null"], "format": "date-time" },
          "finished_at": { "type": ["string", "null"], "format": "date-time" },
          "created_at": { "type": "string", "format": "date-time" }
        }
      }
    },
    "attempts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["run_attempt_id", "run_segment_id", "attempt_no", "reason", "status", "worker_id", "started_at", "finished_at", "error", "created_at"],
        "properties": {
          "run_attempt_id": { "type": "string", "format": "uuid" },
          "run_segment_id": { "type": ["string", "null"], "format": "uuid" },
          "attempt_no": { "type": "integer", "minimum": 1 },
          "reason": { "type": "string", "minLength": 1 },
          "status": { "enum": ["CREATED", "LEASED", "RUNNING", "DEFERRED", "SUCCEEDED", "FAILED", "CANCELLED", "LEASE_EXPIRED"] },
          "worker_id": { "type": ["string", "null"] },
          "started_at": { "type": ["string", "null"], "format": "date-time" },
          "finished_at": { "type": ["string", "null"], "format": "date-time" },
          "error": { "type": ["object", "null"] },
          "created_at": { "type": "string", "format": "date-time" }
        }
      }
    },
    "sessions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["agent_session_id", "run_segment_id", "run_attempt_id", "sdk_session_id", "parent_session_id", "continuation_mode", "session_kind", "checkpoint_checksum", "engine_options_checksum", "engine", "sdk_version", "cli_version", "model", "status", "usage", "cost", "created_at", "updated_at"],
        "properties": {
          "agent_session_id": { "type": "string", "format": "uuid" },
          "run_segment_id": { "type": ["string", "null"], "format": "uuid" },
          "run_attempt_id": { "type": "string", "format": "uuid" },
          "sdk_session_id": { "description": "Null only for a fan-out branch that died before the SDK opened a session. A fabricated ID would look lookupable and would not be.", "type": ["string", "null"], "format": "uuid" },
          "parent_session_id": { "type": ["string", "null"], "format": "uuid" },
          "continuation_mode": { "enum": ["INITIAL", "RESUME", "FORK", "REPLACE", "BRANCH"] },
          "session_kind": { "description": "SUBAGENT rows are the per-branch record of a subagent.dispatch/v1 fan-out; their events are folded into the parent session's single tool call.", "enum": ["PRIMARY", "SUBAGENT"] },
          "checkpoint_checksum": { "type": ["string", "null"], "pattern": "^sha256:[a-f0-9]{64}$" },
          "engine_options_checksum": { "type": ["string", "null"], "pattern": "^sha256:[a-f0-9]{64}$" },
          "engine": { "type": "string", "minLength": 1 },
          "sdk_version": { "type": "string", "minLength": 1 },
          "cli_version": { "type": "string", "minLength": 1 },
          "model": { "type": "string", "minLength": 1 },
          "status": { "enum": ["ACTIVE", "IDLE", "CLOSED", "FAILED", "INTERRUPTED"] },
          "usage": { "type": "object" },
          "cost": { "type": "object" },
          "created_at": { "type": "string", "format": "date-time" },
          "updated_at": { "type": "string", "format": "date-time" }
        }
      }
    },
    "interactions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["interaction_id", "run_segment_id", "agent_session_id", "interaction_type", "prompt", "options", "required", "expires_at", "status", "version", "continuation_mode", "checkpoint_checksum", "change_proposal_id", "response", "created_at"],
        "properties": {
          "interaction_id": { "type": "string", "format": "uuid" },
          "run_segment_id": { "type": "string", "format": "uuid" },
          "agent_session_id": { "type": "string", "format": "uuid" },
          "interaction_type": { "enum": ["CLARIFICATION", "CHOICE", "REVIEW", "EFFECT_APPROVAL"] },
          "prompt": { "type": "object" },
          "options": { "type": "array", "items": { "type": "object" } },
          "required": { "type": "boolean" },
          "expires_at": { "type": "string", "format": "date-time" },
          "status": { "enum": ["OPEN", "RESPONDED", "EXPIRED", "CANCELLED"] },
          "version": { "type": "integer", "minimum": 1 },
          "continuation_mode": { "enum": ["RESUME", "FORK", "REPLACE"] },
          "checkpoint_checksum": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
          "change_proposal_id": { "type": ["string", "null"], "format": "uuid" },
          "response": {
            "oneOf": [
              { "type": "null" },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["response_id", "actor_id", "interaction_version", "response", "created_at"],
                "properties": {
                  "response_id": { "type": "string", "format": "uuid" },
                  "actor_id": { "type": "string", "format": "uuid" },
                  "interaction_version": { "type": "integer", "minimum": 1 },
                  "response": { "type": "object" },
                  "created_at": { "type": "string", "format": "date-time" }
                }
              }
            ]
          },
          "created_at": { "type": "string", "format": "date-time" }
        }
      }
    },
    "change_proposals": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["proposal_id", "proposal_ref", "project_id", "run_id", "run_segment_id", "agent_session_id", "target_binding_id", "integration_id", "effect_intent_key", "capability_version", "operation", "target", "summary", "changes", "precondition", "evidence_refs", "risk_level", "reversible", "rollback", "verification", "status", "version", "checksum", "expires_at", "created_at", "updated_at"],
        "properties": {
          "proposal_id": { "type": "string", "format": "uuid" },
          "proposal_ref": { "type": "string", "pattern": "^cp_[a-zA-Z0-9_-]+$" },
          "project_id": { "type": "string", "format": "uuid" },
          "run_id": { "type": "string", "format": "uuid" },
          "run_segment_id": { "type": "string", "format": "uuid" },
          "agent_session_id": { "type": "string", "format": "uuid" },
          "target_binding_id": { "type": "string", "format": "uuid" },
          "integration_id": { "type": "string", "format": "uuid" },
          "effect_intent_key": { "type": "string", "minLength": 1 },
          "capability_version": { "type": "string", "minLength": 1 },
          "operation": { "type": "string", "minLength": 1 },
          "target": { "type": "object" },
          "summary": { "type": "string", "minLength": 1 },
          "changes": { "type": "array", "items": { "type": "object" } },
          "precondition": { "type": "object" },
          "evidence_refs": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^ev_[a-zA-Z0-9_-]+$" } },
          "risk_level": { "enum": ["LOW", "MEDIUM", "HIGH"] },
          "reversible": { "type": "boolean" },
          "rollback": { "type": "object" },
          "verification": { "type": "object" },
          "status": { "enum": ["DRAFT", "PENDING_APPROVAL", "APPROVED", "APPLYING", "APPLIED", "REJECTED", "STALE", "FAILED"] },
          "version": { "type": "integer", "minimum": 1 },
          "checksum": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
          "expires_at": { "type": "string", "format": "date-time" },
          "created_at": { "type": "string", "format": "date-time" },
          "updated_at": { "type": "string", "format": "date-time" }
        }
      }
    },
    "approvals": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["approval_id", "proposal_id", "run_id", "source", "decision", "actor_id", "preauthorization_id", "proposal_version", "proposal_checksum", "reason", "created_at"],
        "properties": {
          "approval_id": { "type": "string", "format": "uuid" },
          "proposal_id": { "type": "string", "format": "uuid" },
          "run_id": { "type": "string", "format": "uuid" },
          "source": { "enum": ["USER", "PREAUTHORIZATION"] },
          "decision": { "enum": ["APPROVED", "REJECTED"] },
          "actor_id": { "type": ["string", "null"], "format": "uuid" },
          "preauthorization_id": { "type": ["string", "null"], "format": "uuid" },
          "proposal_version": { "type": "integer", "minimum": 1 },
          "proposal_checksum": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
          "reason": { "type": "string" },
          "created_at": { "type": "string", "format": "date-time" }
        }
      }
    },
    "effect_executions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["effect_execution_id", "proposal_id", "run_id", "approval_id", "tool_call_id", "status", "provider", "provider_version", "before_ref", "after_ref", "verification", "error", "attempt_no", "executed_at", "created_at", "updated_at"],
        "properties": {
          "effect_execution_id": { "type": "string", "format": "uuid" },
          "proposal_id": { "type": "string", "format": "uuid" },
          "run_id": { "type": "string", "format": "uuid" },
          "approval_id": { "type": "string", "format": "uuid" },
          "tool_call_id": { "type": ["string", "null"], "format": "uuid" },
          "status": { "enum": ["REQUESTED", "LEASED", "APPLYING", "APPLIED", "STALE", "FAILED", "VERIFICATION_FAILED"] },
          "provider": { "type": "string", "minLength": 1 },
          "provider_version": { "type": "string", "minLength": 1 },
          "before_ref": { "type": ["string", "null"], "pattern": "^ev_[a-zA-Z0-9_-]+$" },
          "after_ref": { "type": ["string", "null"], "pattern": "^ev_[a-zA-Z0-9_-]+$" },
          "verification": { "type": "object" },
          "error": { "type": ["object", "null"] },
          "attempt_no": { "type": "integer", "minimum": 0 },
          "executed_at": { "type": ["string", "null"], "format": "date-time" },
          "created_at": { "type": "string", "format": "date-time" },
          "updated_at": { "type": "string", "format": "date-time" }
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["evidence_ref", "tool_call_id", "evidence_type", "source_uri", "source_locator", "content_hash", "snapshot_uri", "excerpt", "metadata", "created_at"],
        "properties": {
          "evidence_ref": { "type": "string", "pattern": "^ev_[a-zA-Z0-9_-]+$" },
          "tool_call_id": { "type": "string", "format": "uuid" },
          "evidence_type": { "type": "string" },
          "source_uri": { "type": "string" },
          "source_locator": { "type": "object" },
          "content_hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
          "snapshot_uri": { "type": ["string", "null"] },
          "excerpt": { "type": ["string", "null"] },
          "metadata": { "type": "object" },
          "created_at": { "type": "string", "format": "date-time" }
        }
      }
    }
  }
}
