{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.projectmind.local/runs/task-create/v1/request.schema.json",
  "title": "Create published task Run request v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["skill_version_id", "task_key", "input", "sources"],
  "properties": {
    "skill_version_id": { "type": "string", "format": "uuid" },
    "task_key": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]*$" },
    "input": { "type": "object" },
    "sources": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "description": "Document scope is explicit: document:<UUID>, documents:<UUID>,<UUID>... (2-5000 distinct IDs), or project-documents:all. Other values identify an Integration candidate or accepted legacy Provider. Omitting an optional document requirement grants no document access.",
        "allOf": [
          {
            "if": {
              "pattern": "^documents?:"
            },
            "then": {
              "oneOf": [
                {
                  "pattern": "^document:[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
                },
                {
                  "pattern": "^documents:[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}(,[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}){1,4999}$"
                }
              ]
            }
          },
          {
            "if": {
              "pattern": "^project-documents"
            },
            "then": {
              "const": "project-documents:all"
            }
          }
        ]
      }
    }
  }
}
