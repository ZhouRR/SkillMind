{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.projectmind.local/view-spec/v1alpha1.schema.json",
  "title": "ProjectMind ViewSpec v1alpha1",
  "type": "object",
  "additionalProperties": false,
  "required": ["view_version", "key", "title", "mode", "input", "preflight", "result"],
  "properties": {
    "view_version": { "const": "projectmind.view/v1alpha1" },
    "key": { "$ref": "#/$defs/key" },
    "title": { "type": "string", "minLength": 1 },
    "mode": { "enum": ["form", "dashboard", "report", "mixed"] },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_ref", "layout"],
      "properties": {
        "schema_ref": { "type": "string", "minLength": 1 },
        "layout": { "type": "array", "items": { "$ref": "#/$defs/component" } }
      }
    },
    "preflight": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sections"],
      "properties": {
        "sections": {
          "type": "array",
          "items": { "enum": ["workflow", "selected_sources", "automatic_tools", "hard_denies", "limits"] },
          "uniqueItems": true
        }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sections"],
      "properties": {
        "sections": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/component" } }
      }
    },
    "actions": {
      "type": "array",
      "items": { "enum": ["run.execute", "run.retry", "run.cancel", "report.export"] },
      "uniqueItems": true
    },
    "responsive": { "type": "object" },
    "i18n": { "type": "object" }
  },
  "$defs": {
    "key": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]*$" },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component"],
      "properties": {
        "component": {
          "enum": [
            "schema-form",
            "text-field",
            "enum-select",
            "source-picker",
            "summary",
            "metric-grid",
            "finding-list",
            "data-table",
            "evidence-panel",
            "artifact-list",
            "evaluation-form",
            "raw-result"
          ]
        },
        "pointer": { "type": "string", "pattern": "^/" },
        "source_key": { "$ref": "#/$defs/key" },
        "source": { "type": "string" },
        "width": { "type": "integer", "minimum": 1, "maximum": 12 }
      }
    }
  }
}

