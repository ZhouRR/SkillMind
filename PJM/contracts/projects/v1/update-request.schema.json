{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.projectmind.local/projects/v1/update-request.schema.json",
  "title": "ProjectMind Update Project Request v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["expected_row_version"],
  "anyOf": [
    { "required": ["name"], "properties": { "name": { "type": "string" } } },
    { "required": ["description"], "properties": { "description": { "type": "string" } } },
    { "required": ["settings"], "properties": { "settings": { "type": "object" } } },
    { "required": ["retention_days"], "properties": { "retention_days": { "type": "integer" } } }
  ],
  "properties": {
    "expected_row_version": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
    "name": { "type": ["string", "null"], "minLength": 1, "maxLength": 200 },
    "description": { "type": ["string", "null"], "maxLength": 4000 },
    "settings": { "type": ["object", "null"] },
    "retention_days": { "type": ["integer", "null"], "minimum": 1, "maximum": 3650 }
  }
}
