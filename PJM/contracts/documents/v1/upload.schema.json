{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.projectmind.local/documents/v1/upload.schema.json",
  "title": "ProjectMind Original Document Upload v1",
  "description": "Original actor-scoped upload receipt; publication metadata does not prove that the document still exists or that blob cleanup is complete.",
  "type": "object",
  "additionalProperties": false,
  "required": ["upload_key", "project_id", "state", "created_at", "document"],
  "properties": {
    "upload_key": {
      "type": "string", "format": "uuid",
      "not": { "const": "00000000-0000-0000-0000-000000000000" }
    },
    "project_id": { "type": "string", "format": "uuid" },
    "state": { "enum": ["PENDING", "PUBLISHED"] },
    "created_at": {
      "type": "string", "format": "date-time", "pattern": "(?:[zZ]|[+-][0-9]{2}:[0-9]{2})$"
    },
    "document": {
      "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/document" }],
      "properties": {
        "created_at": { "pattern": "(?:[zZ]|[+-][0-9]{2}:[0-9]{2})$" }
      }
    }
  },
  "if": { "properties": { "state": { "const": "PENDING" } } },
  "then": { "properties": { "document": { "type": "null" } } },
  "else": { "properties": { "document": { "$ref": "#/$defs/document" } } },
  "$defs": {
    "document": {
      "title": "ProjectMind Project Document v1",
      "type": "object",
      "additionalProperties": false,
      "required": ["document_id", "project_id", "folder", "name", "size", "mime", "checksum", "uploaded_by", "created_at"],
      "properties": {
        "document_id": { "type": "string", "format": "uuid" },
        "project_id": { "type": "string", "format": "uuid" },
        "folder": { "type": "string", "maxLength": 200 },
        "name": { "type": "string", "minLength": 1, "maxLength": 200 },
        "size": { "type": "integer", "minimum": 0 },
        "mime": { "type": "string", "minLength": 1, "maxLength": 128 },
        "checksum": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "uploaded_by": { "type": "string", "format": "uuid" },
        "created_at": { "type": "string", "format": "date-time" }
      }
    }
  }
}
