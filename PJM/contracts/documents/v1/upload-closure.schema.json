{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.projectmind.local/documents/v1/upload-closure.schema.json",
  "title": "ProjectMind Document Upload Publication Closure v1",
  "description": "Independent immutable publication closure receipt for the original actor/project/upload key. It is not proof of stopped remote writes, blob cleanup, or quota settlement.",
  "type": "object",
  "additionalProperties": false,
  "required": ["upload_key", "project_id", "document_id", "closed_at", "publication_state"],
  "properties": {
    "upload_key": {
      "type": "string", "format": "uuid",
      "not": { "const": "00000000-0000-0000-0000-000000000000" }
    },
    "project_id": {
      "type": "string", "format": "uuid",
      "not": { "const": "00000000-0000-0000-0000-000000000000" }
    },
    "document_id": {
      "type": "string", "format": "uuid",
      "not": { "const": "00000000-0000-0000-0000-000000000000" }
    },
    "closed_at": {
      "type": "string", "format": "date-time", "pattern": "(?:[zZ]|[+-][0-9]{2}:[0-9]{2})$"
    },
    "publication_state": { "type": "string", "const": "CLOSED" }
  }
}
