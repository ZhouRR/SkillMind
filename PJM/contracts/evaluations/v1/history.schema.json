{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.projectmind.local/evaluations/v1/history.schema.json",
  "title": "Evaluation history response v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["items"],
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "evaluation_id", "result_id", "run_id", "user_id", "rating", "verdict",
          "comment", "revisions", "created_at"
        ],
        "properties": {
          "evaluation_id": { "type": "string", "format": "uuid" },
          "result_id": { "type": "string", "format": "uuid" },
          "run_id": { "type": "string", "format": "uuid" },
          "user_id": { "type": "string", "format": "uuid" },
          "rating": { "type": "integer", "minimum": 1, "maximum": 5 },
          "verdict": { "enum": ["accurate", "partially_accurate", "inaccurate", "uncertain"] },
          "comment": { "type": "string", "maxLength": 4000 },
          "revisions": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["pointer", "original_value", "suggested_value", "reason"],
              "properties": {
                "pointer": { "type": "string", "minLength": 1, "maxLength": 512, "pattern": "^/" },
                "original_value": true,
                "suggested_value": true,
                "reason": { "type": "string", "minLength": 1, "maxLength": 1000 }
              }
            }
          },
          "created_at": { "type": "string", "format": "date-time" }
        }
      }
    }
  }
}
