{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.projectmind.local/tools/change.propose/v1/error.schema.json",
  "title": "change.propose/v1 error",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "code", "message", "retryable"],
  "properties": {
    "status": { "const": "error" },
    "code": { "enum": ["invalid_request", "unavailable"] },
    "message": { "type": "string", "minLength": 1, "maxLength": 500 },
    "retryable": { "type": "boolean" }
  }
}
