{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.projectmind.local/tools/subagent.dispatch/v1/response.schema.json",
  "title": "subagent.dispatch/v1 response",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "provider", "results", "evidence_refs", "budget"],
  "properties": {
    "status": { "const": "success" },
    "provider": { "const": "platform" },
    "results": {
      "description": "One entry per requested branch, in request order. A failed branch reports its failure instead of aborting the group.",
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "outcome", "summary", "agent_session_id"],
        "properties": {
          "key": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$", "maxLength": 64 },
          "outcome": { "enum": ["COMPLETED", "FAILED", "TIMED_OUT", "CANCELLED"] },
          "summary": { "type": "string", "maxLength": 20000 },
          "agent_session_id": { "type": "string", "minLength": 1, "maxLength": 64 },
          "failure_code": { "enum": ["branch_failed", "branch_timed_out", "branch_cancelled"] }
        }
      }
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^ev_[a-zA-Z0-9_-]+$" }
    },
    "budget": {
      "description": "How much of the Run budget the fan-out consumed. Split across branches, never multiplied.",
      "type": "object",
      "additionalProperties": false,
      "required": ["turns_per_branch", "output_bytes_per_branch"],
      "properties": {
        "turns_per_branch": { "type": "integer", "minimum": 1 },
        "output_bytes_per_branch": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
