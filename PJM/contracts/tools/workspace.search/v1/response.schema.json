{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.projectmind.local/tools/workspace.search/v1/response.schema.json",
  "title": "workspace.search/v1 response",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "provider", "matches", "scanned_files", "evidence_refs", "warnings", "truncated"],
  "properties": {
    "status": { "const": "success" },
    "provider": { "const": "workspace" },
    "matches": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "line", "column", "excerpt"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "line": { "type": "integer", "minimum": 1 },
          "column": { "type": "integer", "minimum": 1 },
          "excerpt": { "type": "string", "maxLength": 1000 }
        }
      }
    },
    "scanned_files": { "type": "integer", "minimum": 0, "maximum": 500 },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^ev_[a-zA-Z0-9_-]+$" },
      "uniqueItems": true
    },
    "warnings": { "type": "array", "items": { "type": "string" } },
    "truncated": { "type": "boolean" }
  }
}
