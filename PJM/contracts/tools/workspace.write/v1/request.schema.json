{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.projectmind.local/tools/workspace.write/v1/request.schema.json",
  "title": "workspace.write/v1 request",
  "type": "object",
  "additionalProperties": false,
  "required": ["path", "content", "purpose"],
  "properties": {
    "path": {
      "type": "string",
      "minLength": 8,
      "maxLength": 4096,
      "pattern": "^(?:workspace|output)/",
      "not": { "pattern": "(^/|(^|/)\\.\\.(/|$))" }
    },
    "content": { "type": "string", "maxLength": 1000000 },
    "purpose": { "type": "string", "minLength": 1, "maxLength": 500 }
  }
}
