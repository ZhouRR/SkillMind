{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.projectmind.local/tools/workspace.write/v1/response.schema.json",
  "title": "workspace.write/v1 response",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "provider", "path", "content_hash", "bytes_written", "created", "evidence_refs", "warnings"],
  "properties": {
    "status": { "const": "success" },
    "provider": { "const": "workspace" },
    "path": { "type": "string", "minLength": 1 },
    "content_hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "bytes_written": { "type": "integer", "minimum": 0 },
    "created": { "type": "boolean" },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^ev_[a-zA-Z0-9_-]+$" },
      "uniqueItems": true
    },
    "warnings": { "type": "array", "items": { "type": "string" } }
  }
}
