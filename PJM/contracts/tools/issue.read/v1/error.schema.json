{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.projectmind.local/tools/issue.read/v1/error.schema.json",
  "title": "issue.read/v1 error",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "code", "message", "retryable"],
  "properties": {
    "status": { "const": "error" },
    "code": { "enum": ["not_found", "unavailable", "scope_denied", "invalid_request"] },
    "message": { "type": "string", "minLength": 1 },
    "retryable": { "type": "boolean" }
  }
}

