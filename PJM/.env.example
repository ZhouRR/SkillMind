COMPOSE_PROJECT_NAME=projectmind

# Existing shared Traefik contract. ProjectMind does not deploy Traefik.
PROJECTMIND_HOST=projectmind.example.com
PROJECTMIND_CONTEXT_PATH=/projectmind
TRAEFIK_NETWORK=traefik-public
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_TLS=true

# Application
PROJECTMIND_ENVIRONMENT=production
PROJECTMIND_TIMEZONE=Asia/Tokyo
PROJECTMIND_LOG_LEVEL=INFO
PROJECTMIND_API_PORT=8000
PROJECTMIND_CONTRACTS_DIR=/app/contracts
PROJECTMIND_TRUSTED_PROXY_CIDRS=172.16.0.0/12
PROJECTMIND_SSE_HEARTBEAT_SECONDS=15
PROJECTMIND_AUTH_LOGIN_CSRF_TTL_SECONDS=300
PROJECTMIND_AUTH_SESSION_IDLE_MINUTES=30
PROJECTMIND_AUTH_SESSION_ABSOLUTE_HOURS=12
PROJECTMIND_AUTH_ADMIN_SESSION_ABSOLUTE_HOURS=8
PROJECTMIND_AUTH_LOGIN_ATTEMPTS_PER_MINUTE=5
# 来源 quota は login-context と login の両 request を数える。
PROJECTMIND_AUTH_LOGIN_ACCOUNT_ATTEMPTS_PER_MINUTE=15
PROJECTMIND_AUTH_LOGIN_SOURCE_REQUESTS_PER_MINUTE=100
PROJECTMIND_AUTH_LOGIN_PROTECTION_TIMEOUT_SECONDS=2

# PostgreSQL
POSTGRES_DB=projectmind
POSTGRES_USER=projectmind
POSTGRES_PASSWORD=change-me
PROJECTMIND_DATABASE_URL=postgresql+asyncpg://projectmind:change-me@postgres:5432/projectmind

# Redis / ARQ
PROJECTMIND_REDIS_URL=redis://redis:6379/0
PROJECTMIND_QUEUE_NAME=projectmind:runs
PROJECTMIND_WORKER_DISPATCH_ENABLED=false
PROJECTMIND_OUTBOX_BATCH_SIZE=20
PROJECTMIND_RUN_LEASE_SECONDS=60
PROJECTMIND_RUN_MAX_ATTEMPTS=3
# 資源取得と ContextBuilder の準備期限。モデルの wall timeout と終態 transaction には適用しない。
PROJECTMIND_RUN_PREPARATION_TIMEOUT_SECONDS=300
PROJECTMIND_RUN_WORKSPACE_ROOT=/var/lib/projectmind/runs
# 各資源 root の物化上限。manifest・索引も含め、超過時は切り詰めず準備を拒否する。
PROJECTMIND_WORKSPACE_MATERIALIZE_MAX_BYTES=10485760
PROJECTMIND_WORKSPACE_MATERIALIZE_MAX_FILES=500
# Run 全入力の最終存量。逐 root の上限とは独立し、全 root 完成前には Agent を起動しない。
PROJECTMIND_WORKSPACE_MATERIALIZE_TOTAL_MAX_BYTES=104857600
PROJECTMIND_WORKSPACE_MATERIALIZE_TOTAL_MAX_FILES=5000
# Timeout for a single git/svn command issued by the repository Provider (seconds).
PROJECTMIND_REPOSITORY_COMMAND_TIMEOUT_SECONDS=120
# 扇出子 Agent 一路あたりの打ち切り秒数。Run の wall timeout (900) より必ず短くする。
PROJECTMIND_SUBAGENT_BRANCH_TIMEOUT_SECONDS=300

# Object storage. M0 accesses this only through the API/Worker boundary.
MINIO_ROOT_USER=projectmind
MINIO_ROOT_PASSWORD=change-me-too
PROJECTMIND_OBJECT_STORAGE_ENDPOINT=http://object-storage:9000
PROJECTMIND_OBJECT_STORAGE_BUCKET=projectmind
PROJECTMIND_OBJECT_STORAGE_ACCESS_KEY=projectmind
PROJECTMIND_OBJECT_STORAGE_SECRET_KEY=change-me-too
# Upload limits: per-file bytes, per-Project quota bytes, and the allowed content-type allowlist (JSON array).
PROJECTMIND_DOCUMENT_MAX_BYTES=26214400
PROJECTMIND_PROJECT_DOCUMENT_QUOTA_BYTES=524288000
PROJECTMIND_DOCUMENT_ALLOWED_CONTENT_TYPES=["text/plain","text/markdown","text/csv","text/html","application/json","application/yaml","application/pdf","image/png","image/jpeg","image/gif","application/zip"]

# Managed secret envelope encryption (KEK) for MANAGED SecretReferences.
# Format: comma-separated "version:base64key" keyring; the first entry is the active key used for new
# encryption and the rest are decrypt-only during rotation. Each key MUST be 32 random bytes, base64
# encoded (generate with: python -c "import base64,os;print('v1:'+base64.b64encode(os.urandom(32)).decode())").
# Leave empty to disable MANAGED (ENVIRONMENT/FILE stay available). Store the KEK apart from DB backups.
PROJECTMIND_MANAGED_SECRET_KEK=

# Model/provider credentials are consumed by the controlled Worker boundary.
# ANTHROPIC_MODEL is also the audited primary model ID for each Run and may name a custom model.
ANTHROPIC_BASE_URL=
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_MODEL=
ANTHROPIC_DEFAULT_OPUS_MODEL=
ANTHROPIC_DEFAULT_SONNET_MODEL=
ANTHROPIC_DEFAULT_HAIKU_MODEL=
CLAUDE_CODE_SUBAGENT_MODEL=
CLAUDE_CODE_EFFORT_LEVEL=

# Skill interpreter JSON handling. Leave false when the endpoint supports Anthropic structured
# outputs (output_format: json_schema). Set true for Anthropic-compatible endpoints that only offer
# json_object and return the JSON in the message text (e.g. Kimi): the interpreter then accepts a
# JSON object parsed from the prompt-guided text, with schema validation + repair still enforced.
PROJECTMIND_SKILL_INTERPRETER_ACCEPT_PROMPT_JSON=false
