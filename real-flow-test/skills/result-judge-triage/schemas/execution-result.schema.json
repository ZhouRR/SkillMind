{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "testRunId",
    "documentId",
    "specVersion",
    "executionId",
    "executionStatus",
    "versionSnapshot",
    "startedAt",
    "finishedAt",
    "cases",
    "error",
    "executionBasis"
  ],
  "properties": {
    "schemaVersion": {
      "const": "2.0"
    },
    "testRunId": {
      "type": "string",
      "format": "uuid"
    },
    "documentId": {
      "type": "string",
      "format": "uuid"
    },
    "specVersion": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "description": "RV 文書の登録値を引き継ぐ。executionBasis.specVersion および DB と照合する。"
    },
    "executionId": {
      "type": "string",
      "format": "uuid"
    },
    "executionStatus": {
      "enum": [
        "COMPLETED",
        "ERROR",
        "TIMEOUT",
        "ABORTED"
      ]
    },
    "versionSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "skillVersion",
        "environmentVersion",
        "sutBuild",
        "runnerVersions",
        "modelVersion"
      ],
      "properties": {
        "environmentVersion": {
          "type": "string",
          "minLength": 1,
          "description": "公開された環境設定または監査済み回答で確認した環境版。appId やサーバー名から推測しない。"
        },
        "sutBuild": {
          "type": "string",
          "minLength": 1,
          "description": "登録対象アプリの確認済みビルド。環境版・Runner 版で代用しない。"
        },
        "runnerVersions": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          },
          "description": "確認済みの版を識別体系別の key で保持する。MCP tools/v1 の server.version は mcpServer:<server.name>、操作応答の runnerVersion は別 key とする。異なる体系の文字列同士を比較しない。固定後に得た版は操作記録に残す。"
        },
        "modelVersion": {
          "type": "string",
          "minLength": 1,
          "description": "実行登録時のプラットフォーム runtime_metadata.model にある設定モデル ID。非公開のモデル内部ビルドは要求しない。"
        },
        "skillVersion": {
          "type": "string",
          "minLength": 1,
          "description": "実行 Skill の固定公開版または checksum。実行・判定へ同じ値を引き継ぐ。"
        }
      }
    },
    "startedAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "finishedAt": {
      "type": "string",
      "format": "date-time"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "testCaseId",
          "executionStatus",
          "steps",
          "error"
        ],
        "properties": {
          "testCaseId": {
            "type": "string",
            "minLength": 1
          },
          "executionStatus": {
            "enum": [
              "QUEUED",
              "RUNNING",
              "COMPLETED",
              "ERROR",
              "TIMEOUT",
              "ABORTED",
              "NOT_RUN"
            ]
          },
          "steps": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "stepId",
                "executionStatus",
                "actualResult",
                "evidence",
                "error"
              ],
              "properties": {
                "stepId": {
                  "type": "string",
                  "minLength": 1
                },
                "executionStatus": {
                  "enum": [
                    "QUEUED",
                    "RUNNING",
                    "COMPLETED",
                    "ERROR",
                    "TIMEOUT",
                    "ABORTED",
                    "NOT_RUN"
                  ]
                },
                "actualResult": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "evidence": {
                  "type": "array",
                  "minItems": 0,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "evidenceId",
                      "reference",
                      "type"
                    ],
                    "properties": {
                      "evidenceId": {
                        "type": "string",
                        "minLength": 1
                      },
                      "reference": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "documentLibraryId",
                          "bucket",
                          "objectKey"
                        ],
                        "properties": {
                          "documentLibraryId": {
                            "type": "string",
                            "minLength": 1
                          },
                          "bucket": {
                            "type": "string",
                            "minLength": 1
                          },
                          "objectKey": {
                            "type": "string",
                            "minLength": 1,
                            "pattern": "^(?!/)(?![A-Za-z][A-Za-z0-9+.-]*://).+"
                          }
                        }
                      },
                      "type": {
                        "enum": [
                          "SCREENSHOT",
                          "VIDEO",
                          "TRACE",
                          "LOG",
                          "DB_RESULT",
                          "ACTUAL_OUTPUT"
                        ]
                      }
                    }
                  }
                },
                "error": {
                  "type": [
                    "object",
                    "null"
                  ]
                }
              }
            }
          },
          "error": {
            "type": [
              "object",
              "null"
            ]
          }
        }
      }
    },
    "error": {
      "type": [
        "object",
        "null"
      ]
    },
    "executionBasis": {
      "title": "Markdown 直接実行の根拠",
      "description": "実行登録の execution_basis に保存する。独立した計画成果物や状態管理は作らない。ID・行範囲・全件対応・依存関係は原文と別途照合する。",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceMarkdown",
        "specVersion",
        "cases",
        "environment"
      ],
      "properties": {
        "sourceMarkdown": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "documentLibraryId",
            "bucket",
            "objectKey",
            "sha256"
          ],
          "properties": {
            "documentLibraryId": {
              "type": "string",
              "minLength": 1
            },
            "bucket": {
              "type": "string",
              "minLength": 1
            },
            "objectKey": {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?!/)(?![A-Za-z][A-Za-z0-9+.-]*://).+"
            },
            "sha256": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          },
          "description": "RV 済み Markdown の取得元と原バイト列の SHA-256。実行登録値と照合する。"
        },
        "specVersion": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "cases": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "testCaseId",
              "steps"
            ],
            "properties": {
              "testCaseId": {
                "type": "string",
                "minLength": 1
              },
              "steps": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "stepId",
                    "sourceLines",
                    "expectedLines",
                    "dependsOn"
                  ],
                  "properties": {
                    "stepId": {
                      "type": "string",
                      "minLength": 1
                    },
                    "sourceLines": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "start",
                        "end"
                      ],
                      "properties": {
                        "start": {
                          "type": "integer",
                          "minimum": 1
                        },
                        "end": {
                          "type": "integer",
                          "minimum": 1
                        }
                      },
                      "description": "UTF-8 Markdown の 1 始まりの包含行範囲。end >= start と文書内の範囲を別途検証する。"
                    },
                    "expectedLines": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "start",
                        "end"
                      ],
                      "properties": {
                        "start": {
                          "type": "integer",
                          "minimum": 1
                        },
                        "end": {
                          "type": "integer",
                          "minimum": 1
                        }
                      },
                      "description": "UTF-8 Markdown の 1 始まりの包含行範囲。end >= start と文書内の範囲を別途検証する。"
                    },
                    "dependsOn": {
                      "type": "array",
                      "uniqueItems": true,
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "testCaseId",
                          "stepId"
                        ],
                        "properties": {
                          "testCaseId": {
                            "type": "string",
                            "minLength": 1
                          },
                          "stepId": {
                            "type": "string",
                            "minLength": 1
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "environment": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "appId",
            "connectionRef",
            "environmentLease",
            "maxParallelism",
            "caseTimeoutSeconds"
          ],
          "properties": {
            "appId": {
              "type": "string",
              "minLength": 1
            },
            "connectionRef": {
              "type": "string",
              "minLength": 1
            },
            "environmentLease": {
              "type": "string",
              "minLength": 1
            },
            "maxParallelism": {
              "const": 1
            },
            "caseTimeoutSeconds": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    }
  },
  "title": "Runner の実行終了結果",
  "description": "実行前に登録した根拠の全ケース・ステップを含める。未実行は NOT_RUN とし、欠落・未知を成功扱いしない。DB との根拠の完全一致は別途検証する。"
}
