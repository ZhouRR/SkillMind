{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "原記録に基づく製品不具合候補",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "executionId",
    "testRunId",
    "documentId",
    "testCaseId",
    "classification",
    "failureFingerprint",
    "disposition",
    "title",
    "expectedResult",
    "actualResult",
    "reproductionSteps",
    "evidenceRefs",
    "versionSnapshot",
    "knownIssues",
    "sourceMarkdown"
  ],
  "properties": {
    "schemaVersion": {
      "const": "3.0"
    },
    "executionId": {
      "type": "string",
      "format": "uuid"
    },
    "testRunId": {
      "type": "string",
      "format": "uuid"
    },
    "documentId": {
      "type": "string",
      "format": "uuid"
    },
    "testCaseId": {
      "type": "string",
      "minLength": 1
    },
    "classification": {
      "const": "PRODUCT"
    },
    "failureFingerprint": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "disposition": {
      "enum": [
        "NEW_CANDIDATE",
        "KNOWN_ISSUE",
        "CHECK_REQUIRED"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "expectedResult": {
      "type": "string",
      "minLength": 1
    },
    "actualResult": {
      "type": "string",
      "minLength": 1
    },
    "reproductionSteps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "evidenceRefs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/runnerEvidence"
      }
    },
    "versionSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "skillVersion",
        "environmentVersion",
        "sutBuild",
        "runnerVersions",
        "modelVersion"
      ],
      "properties": {
        "environmentVersion": {
          "type": "string",
          "minLength": 1
        },
        "sutBuild": {
          "type": "string",
          "minLength": 1
        },
        "runnerVersions": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "modelVersion": {
          "type": "string",
          "minLength": 1
        },
        "skillVersion": {
          "type": "string",
          "minLength": 1,
          "description": "実行 Skill の固定公開版または checksum。実行・判定へ同じ値を引き継ぐ。"
        }
      }
    },
    "knownIssues": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "url",
          "matchReason"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": [
              "string",
              "null"
            ]
          },
          "matchReason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "sourceMarkdown": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "documentLibraryId",
        "bucket",
        "objectKey",
        "sha256"
      ],
      "properties": {
        "documentLibraryId": {
          "type": "string",
          "minLength": 1
        },
        "bucket": {
          "type": "string",
          "minLength": 1
        },
        "objectKey": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?![A-Za-z][A-Za-z0-9+.-]*://).+"
        },
        "sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "description": "RV 済み Markdown の取得元と原バイト列の SHA-256。実行登録値と照合する。"
    }
  },
  "$defs": {
    "runnerRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "locator"
      ],
      "properties": {
        "locator": {
          "type": "string",
          "minLength": 1,
          "description": "原サービスが返す記録識別子/取得入口。opaque な値であり、任意 URL アクセス権ではない。"
        },
        "sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$",
          "description": "原記録のバイト列を取得できた場合の hash。推測しない。"
        },
        "archive": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "documentLibraryId",
            "bucket",
            "objectKey",
            "sha256"
          ],
          "properties": {
            "documentLibraryId": {
              "type": "string",
              "minLength": 1
            },
            "bucket": {
              "type": "string",
              "minLength": 1
            },
            "objectKey": {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?!/)(?![A-Za-z][A-Za-z0-9+.-]*://).+"
            },
            "sha256": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          },
          "description": "実際に取得して原バイト列のまま保存した退避先。原ファイルと hash を照合する。"
        }
      },
      "description": "Runner の原記録への参照。本文を複写しない。取得・保存・内容確認は別々に検証する。"
    },
    "runnerEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "connectionRef",
        "requestId",
        "record"
      ],
      "properties": {
        "connectionRef": {
          "type": "string",
          "minLength": 1
        },
        "requestId": {
          "type": "string",
          "minLength": 1
        },
        "record": {
          "$ref": "#/$defs/runnerRecord"
        }
      },
      "description": "このケースの参照索引と照合し、実際に読めた Runner 原記録/原画像だけを引用する。原接続・原要求の対応は Schema だけでは証明できない。"
    }
  }
}
