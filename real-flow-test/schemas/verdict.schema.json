{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "testRunId",
    "documentId",
    "specVersion",
    "executionId",
    "testCaseId",
    "executionStatus",
    "versionSnapshot",
    "judgementModelVersion",
    "verdict",
    "confidence",
    "classification",
    "assessments",
    "missingEvidence",
    "counterEvidence",
    "failureFingerprint",
    "fingerprintBasis",
    "knownIssueCheck",
    "knownIssues",
    "recommendedActions",
    "sourceMarkdown"
  ],
  "properties": {
    "schemaVersion": {
      "const": "3.0"
    },
    "testRunId": {
      "type": "string",
      "format": "uuid"
    },
    "documentId": {
      "type": "string",
      "format": "uuid"
    },
    "specVersion": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "executionId": {
      "type": "string",
      "format": "uuid"
    },
    "testCaseId": {
      "type": "string",
      "minLength": 1
    },
    "executionStatus": {
      "enum": [
        "QUEUED",
        "RUNNING",
        "COMPLETED",
        "ERROR",
        "TIMEOUT",
        "ABORTED",
        "NOT_RUN"
      ]
    },
    "versionSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "skillVersion",
        "environmentVersion",
        "sutBuild",
        "runnerVersions",
        "modelVersion"
      ],
      "properties": {
        "environmentVersion": {
          "type": "string",
          "minLength": 1
        },
        "sutBuild": {
          "type": "string",
          "minLength": 1
        },
        "runnerVersions": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "modelVersion": {
          "type": "string",
          "minLength": 1
        },
        "skillVersion": {
          "type": "string",
          "minLength": 1,
          "description": "実行 Skill の固定公開版または checksum。実行・判定へ同じ値を引き継ぐ。"
        }
      },
      "description": "test_execution.version_snapshot の登録値を使用する。実行モデルと判定モデル、異なる版体系を混同しない。"
    },
    "judgementModelVersion": {
      "type": "string",
      "minLength": 1
    },
    "verdict": {
      "enum": [
        "PASS",
        "FAIL",
        "BLOCKED",
        "INCONCLUSIVE"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "classification": {
      "enum": [
        "PRODUCT",
        "TEST",
        "ENV",
        "FLAKY",
        "UNKNOWN",
        null
      ]
    },
    "assessments": {
      "type": "array",
      "minItems": 0,
      "description": "ステップ別の照合結果。ケース全体が同一理由で未実行（result_ref.notRun の stepId: \"*\"）または共通の前置阻害で一括判定される場合は、stepId: \"*\" の 1 要素に集約（または空配列）してよい。",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "stepId",
          "executionStatus",
          "satisfied"
        ],
        "properties": {
          "stepId": {
            "type": "string",
            "minLength": 1,
            "description": "個別ステップ ID。ケース全体が同一理由で未実行・前置阻害の場合は \"*\" で集約可能（PASS 時は \"*\" 不可）。"
          },
          "expectedResult": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "description": "元の期待条件は sourceMarkdown と execution_basis.cases[].sourceLines で固定済みのため省略可。仕様書全文の複写は行わない。"
          },
          "actualResult": {
            "type": [
              "string",
              "null"
            ],
            "description": "実測結果の要約。未実行や結果不明時は省略または null 可（PASS 時は必須）。"
          },
          "executionStatus": {
            "enum": [
              "QUEUED",
              "RUNNING",
              "COMPLETED",
              "ERROR",
              "TIMEOUT",
              "ABORTED",
              "NOT_RUN",
              null
            ],
            "description": "原記録と送信履歴で確認した状態。記録不足・結果不明は null。見つからないだけで NOT_RUN にしない。"
          },
          "satisfied": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "evidenceRefs": {
            "type": "array",
            "minItems": 0,
            "items": {
              "$ref": "#/$defs/runnerEvidence"
            },
            "description": "確認した Runner 原記録/原画像への参照。未実行時は省略または空配列可（PASS 時は 1 件以上必須）。"
          }
        }
      }
    },
    "missingEvidence": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "counterEvidence": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "failureFingerprint": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "fingerprintBasis": {
      "type": [
        "object",
        "null"
      ]
    },
    "knownIssueCheck": {
      "enum": [
        "CHECKED",
        "UNAVAILABLE"
      ]
    },
    "knownIssues": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "url",
          "matchReason"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": [
              "string",
              "null"
            ]
          },
          "matchReason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "recommendedActions": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "sourceMarkdown": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "documentLibraryId",
        "bucket",
        "objectKey",
        "sha256"
      ],
      "properties": {
        "documentLibraryId": {
          "type": "string",
          "minLength": 1
        },
        "bucket": {
          "type": "string",
          "minLength": 1
        },
        "objectKey": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?![A-Za-z][A-Za-z0-9+.-]*://).+",
          "description": "文書メタデータの path、または folder/name が表す文書庫内相対パス。物理ストレージキーや作業用ローカルパスへ置き換えない。"
        },
        "sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "description": "RV 済み Markdown の取得元と原バイト列の SHA-256。実行登録値と照合する。"
    }
  },
  "title": "ケース別の実測判定",
  "description": "登録済み Markdown・実行根拠と Runner 原記録から判定する。中間実行結果ファイルを要求しない。参照の所有、原バイト列、全ステップ対応は別途照合する。",
  "allOf": [
    {
      "if": {
        "properties": {
          "verdict": {
            "const": "PASS"
          }
        }
      },
      "then": {
        "properties": {
          "executionStatus": {
            "const": "COMPLETED"
          },
          "classification": {
            "type": "null"
          },
          "failureFingerprint": {
            "type": "null"
          },
          "fingerprintBasis": {
            "type": "null"
          },
          "missingEvidence": {
            "maxItems": 0
          },
          "assessments": {
            "minItems": 1,
            "items": {
              "required": [
                "stepId",
                "executionStatus",
                "satisfied",
                "actualResult",
                "evidenceRefs"
              ],
              "properties": {
                "stepId": {
                  "not": {
                    "const": "*"
                  }
                },
                "executionStatus": {
                  "const": "COMPLETED"
                },
                "satisfied": {
                  "const": true
                },
                "actualResult": {
                  "type": "string",
                  "minLength": 1
                },
                "evidenceRefs": {
                  "minItems": 1
                }
              }
            }
          },
          "counterEvidence": {
            "maxItems": 0
          }
        }
      },
      "else": {
        "properties": {
          "classification": {
            "enum": [
              "PRODUCT",
              "TEST",
              "ENV",
              "FLAKY",
              "UNKNOWN"
            ]
          },
          "failureFingerprint": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "fingerprintBasis": {
            "type": "object",
            "minProperties": 1
          }
        }
      }
    }
  ],
  "$defs": {
    "runnerRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "locator"
      ],
      "properties": {
        "locator": {
          "type": "string",
          "minLength": 1,
          "description": "原サービスが返す記録識別子/取得入口。opaque な値であり、任意 URL アクセス権ではない。"
        },
        "sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$",
          "description": "原記録のバイト列を取得できた場合の hash。推測しない。"
        },
        "archive": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "documentLibraryId",
            "bucket",
            "objectKey",
            "sha256"
          ],
          "properties": {
            "documentLibraryId": {
              "type": "string",
              "minLength": 1
            },
            "bucket": {
              "type": "string",
              "minLength": 1
            },
            "objectKey": {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?!/)(?![A-Za-z][A-Za-z0-9+.-]*://).+",
              "description": "文書メタデータの path、または folder/name が表す文書庫内相対パス。物理ストレージキーや作業用ローカルパスへ置き換えない。"
            },
            "sha256": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          },
          "description": "実際に取得して原バイト列のまま保存した退避先。原ファイルと hash を照合する。"
        }
      },
      "description": "Runner の原記録への参照。本文を複写しない。取得・保存・内容確認は別々に検証する。"
    },
    "runnerEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "connectionRef",
        "requestId",
        "record"
      ],
      "properties": {
        "connectionRef": {
          "type": "string",
          "minLength": 1
        },
        "requestId": {
          "type": "string",
          "minLength": 1
        },
        "record": {
          "$ref": "#/$defs/runnerRecord"
        }
      },
      "description": "このケースの参照索引と照合し、実際に読めた Runner 原記録/原画像だけを引用する。原接続・原要求の対応は Schema だけでは証明できない。"
    }
  }
}
